# Build defaults and license notices. Copy to .env (not tracked by Git).
# UTF-8 KEY=value; optional matching quotes; no expansion or shell execution.
SOFTWARE_NAME=SmoothMail
DISTRIBUTION_URL=https://example.invalid/smoothmail/downloads
BUILD_VERSION=0.1.0-review
# Installed matching MSVC Qt SDK. Use forward slashes, also in Windows paths.
SMOOTHMAIL_QT_ROOT=C:/Qt/6.12.0/msvc2022_64
# Optional build paths; empty uses the default / developer environment discovery.
SMOOTHMAIL_DEPENDENCY_ROOT=
SMOOTHMAIL_CRT_BIN=
SMOOTHMAIL_DOWNLOAD_CURL=
SMOOTHMAIL_SOURCE_ARCHIVES=
SMOOTHMAIL_SOURCE_COMMIT=
SMOOTHMAIL_ASSET_CACHE=
# Public native/desktop OAuth registration. Empty means not configured.
# These defaults are embedded at build time; process environment is not used.
SMOOTHMAIL_GOOGLE_CLIENT_ID=
SMOOTHMAIL_GOOGLE_CLIENT_SECRET=
SMOOTHMAIL_MICROSOFT_CLIENT_ID=
