include_guard(GLOBAL)
if(NOT DEFINED DEPENDENCY_ROOT)
    get_filename_component(DEPENDENCY_ROOT "${CMAKE_CURRENT_LIST_DIR}/../build/deps" ABSOLUTE)
endif()
if(NOT DEFINED SMOOTHMAIL_NATIVE_ROOT)
    set(SMOOTHMAIL_NATIVE_ROOT "${DEPENDENCY_ROOT}/native/gnu-runtime-v1")
endif()
get_filename_component(SMOOTHMAIL_NATIVE_ROOT "${SMOOTHMAIL_NATIVE_ROOT}" ABSOLUTE)
if(DEFINED SMOOTHMAIL_NATIVE_PREFIX AND
        NOT SMOOTHMAIL_NATIVE_PREFIX STREQUAL "${SMOOTHMAIL_NATIVE_ROOT}/x64-windows")
    message(FATAL_ERROR "Set SMOOTHMAIL_NATIVE_ROOT consistently instead of overriding only the Intl prefix.")
endif()
set(SMOOTHMAIL_NATIVE_PREFIX "${SMOOTHMAIL_NATIVE_ROOT}/x64-windows")
if(NOT DEFINED SMOOTHMAIL_GETTEXT_TOOLS_ROOT)
    set(SMOOTHMAIL_GETTEXT_TOOLS_ROOT "${DEPENDENCY_ROOT}/native")
endif()
get_filename_component(SMOOTHMAIL_GETTEXT_TOOLS_ROOT "${SMOOTHMAIL_GETTEXT_TOOLS_ROOT}" ABSOLUTE)
if(SMOOTHMAIL_GETTEXT_TOOLS_ROOT STREQUAL SMOOTHMAIL_NATIVE_ROOT)
    message(FATAL_ERROR "Keep gettext host tools and the GNU runtime profile in separate roots.")
endif()
set(SMOOTHMAIL_GETTEXT_TOOLS_BIN "${SMOOTHMAIL_GETTEXT_TOOLS_ROOT}/x64-windows/tools/gettext/bin")

function(smoothmail_prepare_native_profile root digest)
    if(IS_SYMLINK "${root}" OR IS_SYMLINK "${root}/smoothmail-profile.sha256")
        message(FATAL_ERROR "Linked native profile paths are not allowed.")
    endif()
    set(receipt "${root}/smoothmail-profile.sha256")
    if(EXISTS "${receipt}")
        file(READ "${receipt}" installed)
        string(STRIP "${installed}" installed)
        if(NOT installed STREQUAL digest)
            message(FATAL_ERROR "Native profile changed; choose a new SMOOTHMAIL_NATIVE_ROOT. Existing packages were not replaced.")
        endif()
        return()
    elseif(EXISTS "${root}")
        file(GLOB existing "${root}/*" "${root}/.*")
        if(existing)
            message(FATAL_ERROR "Unidentified native prefix; choose a new SMOOTHMAIL_NATIVE_ROOT.")
        endif()
    endif()
    file(MAKE_DIRECTORY "${root}")
    file(WRITE "${receipt}" "${digest}\n")
endfunction()
