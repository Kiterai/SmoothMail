cmake_minimum_required(VERSION 3.30)
# Collect review evidence, not release approval. No manifest.json is produced.
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED DEPENDENCY_ROOT)
    set(DEPENDENCY_ROOT "${repository}/build/deps")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NativeDependencySettings.cmake")
foreach(required IN ITEMS STAGE OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Specify ${required}.")
    endif()
    get_filename_component(${required} "${${required}}" ABSOLUTE)
endforeach()
if(NOT IS_DIRECTORY "${STAGE}" OR EXISTS "${OUTPUT}")
    message(FATAL_ERROR "Choose an existing runtime and a new legal review output directory.")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies.json" dependencies)
file(MAKE_DIRECTORY "${OUTPUT}")
set(manifest "{\"schema\":1,\"components\":[]}")
set(inventory "SHA256  runtime-relative-file  component\n")
set(assigned)
set(index 0)

function(quote_json out text)
    string(REPLACE "\\" "\\\\" text "${text}")
    string(REPLACE "\"" "\\\"" text "${text}")
    string(REPLACE "\n" "\\n" text "${text}")
    set(${out} "\"${text}\"" PARENT_SCOPE)
endfunction()

macro(component id version binaries source)
    set(object "{\"name\":\"${id}\",\"version\":\"${version}\",\"binaries\":[],\"license_files\":[]}")
    set(binary_index 0)
    foreach(binary IN ITEMS ${binaries})
        if(NOT EXISTS "${STAGE}/${binary}" OR binary IN_LIST assigned)
            message(FATAL_ERROR "Missing or multiply assigned runtime file: ${binary}")
        endif()
        list(APPEND assigned "${binary}")
        file(SHA256 "${STAGE}/${binary}" digest)
        string(APPEND inventory "${digest}  ${binary}  ${id}\n")
        quote_json(quoted "${binary}")
        string(JSON object SET "${object}" binaries ${binary_index} "${quoted}")
        math(EXPR binary_index "${binary_index}+1")
    endforeach()
    set(notice "notices/${id}.md")
    file(MAKE_DIRECTORY "${OUTPUT}/notices")
    file(WRITE "${OUTPUT}/${notice}"
        "# ${id} ${version}\n\nREVIEW ONLY - NOT APPROVED FOR DISTRIBUTION.\n\nSource: ${source}\n\nSee REVIEW.md for unresolved source delivery, license selection and redistribution checks.\n")
    quote_json(quoted "${notice}")
    string(JSON object SET "${object}" source_notice "${quoted}")
    set(license_index 0)
endmacro()

macro(original from name)
    if(NOT EXISTS "${from}")
        message(FATAL_ERROR "Missing original license evidence: ${name}")
    endif()
    get_filename_component(parent "${OUTPUT}/${name}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(COPY_FILE "${from}" "${OUTPUT}/${name}")
    quote_json(quoted "${name}")
    string(JSON object SET "${object}" license_files ${license_index} "${quoted}")
    math(EXPR license_index "${license_index}+1")
endmacro()

macro(finish_component)
    string(JSON manifest SET "${manifest}" components ${index} "${object}")
    math(EXPR index "${index}+1")
endmacro()

component(SmoothMail MIT "smoothmail.exe;qt.conf" "This repository; LICENSE and THIRD_PARTY_NOTICES.md. Complete release source and build scripts must accompany the selected delivery method.")
original("${repository}/LICENSE" "licenses/SmoothMail/LICENSE")
finish_component()

# Preserve whole upstream LICENSES sets as evidence; their presence does NOT
# claim every file's license applies to the selected library binary.
set(kde_components kcodecs kconfig kcoreaddons kcrash ki18n kio kmime kservice kimap ksmtp)
set(kde_binaries KF6Codecs.dll KF6ConfigCore.dll KF6CoreAddons.dll KF6Crash.dll KF6I18n.dll KF6KIOCore.dll KF6Mime.dll KF6Service.dll KPim6IMAP.dll KPim6SMTP.dll)
foreach(i RANGE 0 9)
    list(GET kde_components ${i} id)
    list(GET kde_binaries ${i} binary)
    string(JSON url GET "${dependencies}" "${id}" repository)
    string(JSON commit GET "${dependencies}" "${id}" commit)
    string(JSON version GET "${dependencies}" "${id}" tag)
    component("${id}" "${version}" "${binary}" "${url} at ${commit}; SmoothMail changes, if any, are copied alongside this notice.")
    file(GLOB licenses "${DEPENDENCY_ROOT}/src/${id}/LICENSES/*")
    foreach(license IN LISTS licenses)
        get_filename_component(name "${license}" NAME)
        original("${license}" "licenses/${id}/${name}")
    endforeach()
    if(NOT licenses)
        message(FATAL_ERROR "Missing KDE license set: ${id}")
    endif()
    file(GLOB patches "${repository}/patches/${id}/*.patch" "${repository}/patches/${id}/README.md")
    foreach(patch IN LISTS patches)
        get_filename_component(name "${patch}" NAME)
        file(COPY_FILE "${patch}" "${OUTPUT}/notices/${id}-${name}")
    endforeach()
    # Keep exact upstream source copyright lines without embedding local paths.
    file(GLOB_RECURSE source_files "${DEPENDENCY_ROOT}/src/${id}/src/*.cpp" "${DEPENDENCY_ROOT}/src/${id}/src/*.h" "${DEPENDENCY_ROOT}/src/${id}/src/*.c")
    set(copyrights "# Upstream source copyright evidence - ${id}\n\nRepository-wide src scan; compiled-file attribution review remains required.\n")
    foreach(source_file IN LISTS source_files)
        file(STRINGS "${source_file}" lines REGEX "SPDX-FileCopyrightText:|[Cc]opyright.*[0-9]")
        if(lines)
            file(RELATIVE_PATH source_relative "${DEPENDENCY_ROOT}/src/${id}" "${source_file}")
            string(APPEND copyrights "\n${source_relative}\n")
            foreach(line IN LISTS lines)
                string(APPEND copyrights "${line}\n")
            endforeach()
        endif()
    endforeach()
    file(WRITE "${OUTPUT}/licenses/${id}/copyright-evidence.txt" "${copyrights}")
    quote_json(quoted "licenses/${id}/copyright-evidence.txt")
    string(JSON object SET "${object}" license_files ${license_index} "${quoted}")
    finish_component()
endforeach()

