    else()
        original("${SMOOTHMAIL_NATIVE_PREFIX}/include/libintl.h" "licenses/${id}/libintl.h")
    endif()
    finish_component()
endforeach()

macro(qt_source_evidence module commit)
    set(qt_source "${DEPENDENCY_ROOT}/qt-license-sources/${module}")
    if(SMOOTHMAIL_SOURCE_ARCHIVES)
        smoothmail_import_source_archive("${module}" "${commit}" qt_source)
    endif()
    if(EXISTS "${qt_source}/LICENSES")
        if(NOT SMOOTHMAIL_SOURCE_ARCHIVES)
            find_package(Git REQUIRED)
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${qt_source}" rev-parse HEAD
                OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${qt_source}" status --porcelain
                OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
            if(NOT actual STREQUAL "${commit}" OR NOT dirty STREQUAL "")
                message(FATAL_ERROR "Qt source evidence is not the reviewed clean revision.")
            endif()
        endif()
        file(GLOB_RECURSE qt_licenses
            "${qt_source}/LICENSES/*.txt"
            "${qt_source}/src/*LICENSE*" "${qt_source}/src/*COPYING*"
            "${qt_source}/src/*LICENCE*" "${qt_source}/src/*COPYRIGHT*"
            "${qt_source}/src/qt_attribution.json")
        file(GLOB_RECURSE attributions "${qt_source}/src/qt_attribution.json")
        foreach(attribution IN LISTS attributions)
            file(READ "${attribution}" attribution_json)
            string(JSON kind TYPE "${attribution_json}")
            if(kind STREQUAL "ARRAY")
                string(JSON attribution_count LENGTH "${attribution_json}")
            else()
                set(attribution_count 1)
            endif()
            math(EXPR attribution_last "${attribution_count}-1")
            foreach(a RANGE 0 ${attribution_last})
                if(kind STREQUAL "ARRAY")
                    string(JSON item GET "${attribution_json}" ${a})
                else()
                    set(item "${attribution_json}")
                endif()
                string(JSON reference ERROR_VARIABLE reference_error GET "${item}" LicenseFile)
                if(reference_error STREQUAL "NOTFOUND" AND NOT reference STREQUAL "")
                    get_filename_component(directory "${attribution}" DIRECTORY)
                    file(REAL_PATH "${directory}/${reference}" referenced)
                    file(REAL_PATH "${qt_source}" source_base)
                    string(FIND "${referenced}" "${source_base}/" contained)
                    if(NOT contained EQUAL 0 OR NOT EXISTS "${referenced}")
                        message(FATAL_ERROR "Missing or unsafe Qt attribution LicenseFile reference.")
                    endif()
                    list(APPEND qt_licenses "${referenced}")
                endif()
            endforeach()
        endforeach()
        list(REMOVE_DUPLICATES qt_licenses)
        list(SORT qt_licenses)
        foreach(license IN LISTS qt_licenses)
            if(NOT IS_DIRECTORY "${license}")
                file(RELATIVE_PATH qt_relative "${qt_source}" "${license}")
                original("${license}" "licenses/${module}/${qt_relative}")
            endif()
        endforeach()
        file(APPEND "${OUTPUT}/${notice}" "\nModule license choice: LGPL-3.0-only (open-source), plus the applicable bundled third-party licenses. Collected repository-wide evidence still needs mapping to the shipped modules.\n")
        if("${module}" STREQUAL "qtbase")
            file(APPEND "${OUTPUT}/${notice}" "\nFor the FreeType alternative used in bundled Qt GUI, select FTL rather than GPL-2.0-only. Portions of this software are copyright (C) 2026 The FreeType Project (www.freetype.org). All rights reserved.\n")
        endif()
    endif()
endmacro()
