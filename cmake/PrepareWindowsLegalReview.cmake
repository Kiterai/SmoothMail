file(GLOB crt_candidates RELATIVE "${STAGE}" "${STAGE}/msvcp*.dll" "${STAGE}/vcruntime*.dll"
    "${STAGE}/concrt*.dll" "${STAGE}/vccorlib*.dll")
if(NOT crt_candidates)
    message(FATAL_ERROR "No CRT files in the runtime candidate.")
endif()
foreach(crt IN LISTS crt_candidates)
    if(NOT crt MATCHES "^(msvcp140(_[12]|_atomic_wait|_codecvt_ids)?|vcruntime140(_1|_threads)?|concrt140|vccorlib140)\\.dll$")
        message(FATAL_ERROR "Unreviewed CRT component.")
    endif()
endforeach()
list(SORT crt_candidates)
component(msvc-crt "MSVC v14" "${crt_candidates}" "Microsoft Visual Studio 2022 Release CRT, required DLLs distributed unmodified in the portable ZIP. The distribution operator is responsible for lawful MSVC 2022 use and compliance with the applicable Microsoft terms/REDIST list. Build checks verify technical provenance, not legal entitlement.")
file(APPEND "${OUTPUT}/${notice}" "\nMicrosoft runtime code is not relicensed under SmoothMail's MIT license. Preserve applicable Microsoft notices and conditions. Source: https://learn.microsoft.com/en-us/visualstudio/releases/2022/redistribution and https://visualstudio.microsoft.com/license-terms/vs2022-cruntime/ . App-local CRT security updates must be delivered by the application distributor.\n")
finish_component()

file(GLOB_RECURSE staged LIST_DIRECTORIES FALSE RELATIVE "${STAGE}" "${STAGE}/*")
list(SORT staged)
list(SORT assigned)
if(NOT staged STREQUAL assigned)
    message(FATAL_ERROR "Runtime inventory differs from the component mapping.")
endif()
file(WRITE "${OUTPUT}/manifest.review.json" "${manifest}\n")
file(WRITE "${OUTPUT}/runtime-components-sha256.txt" "${inventory}")
file(COPY_FILE "${repository}/THIRD_PARTY_NOTICES.md" "${OUTPUT}/THIRD_PARTY_NOTICES.md")
file(COPY_FILE "${repository}/docs/dev/distribution.md" "${OUTPUT}/REVIEW.md")
message(STATUS "Collected ${index} components. REVIEW ONLY: no manifest.json, no release approval.")
