cmake_minimum_required(VERSION 3.30)
# Produce separately downloadable source REVIEW artifacts, never a binary release.
find_package(Git REQUIRED)
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED DEPENDENCY_ROOT)
    set(DEPENDENCY_ROOT "${repository}/build/deps")
endif()
if(NOT DEFINED OUTPUT OR EXISTS "${OUTPUT}")
    message(FATAL_ERROR "Choose a new OUTPUT directory.")
endif()
get_filename_component(OUTPUT "${OUTPUT}" ABSOLUTE)
file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies.json" dependencies)
file(MAKE_DIRECTORY "${OUTPUT}")
set(inventory "{\"schema\":1,\"review_only\":true,\"archives\":[],\"missing\":[]}")
set(index 0)
set(missing_index 0)

macro(source_archive id source commit)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse HEAD
        OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT actual STREQUAL "${commit}")
        message(FATAL_ERROR "Source revision mismatch for ${id}.")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" diff --quiet HEAD RESULT_VARIABLE dirty)
    if(NOT dirty EQUAL 0)
        message(FATAL_ERROR "Tracked source changes for ${id}; commit or choose matching clean input.")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" ls-tree -r HEAD
        OUTPUT_VARIABLE tree COMMAND_ERROR_IS_FATAL ANY)
    if(tree MATCHES "(^|\n)160000 ")
        message(FATAL_ERROR "Unresolved source submodules for ${id}; cannot claim a complete snapshot.")
    endif()
    set(archive "${id}-${commit}.tar")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" archive --format=tar
        "--prefix=${id}/" "--output=${OUTPUT}/${archive}" "${commit}" ${archive_paths}
        COMMAND_ERROR_IS_FATAL ANY)
    file(SHA256 "${OUTPUT}/${archive}" digest)
    string(JSON inventory SET "${inventory}" archives ${index}
        "{\"component\":\"${id}\",\"commit\":\"${commit}\",\"file\":\"${archive}\",\"sha256\":\"${digest}\"}")
    math(EXPR index "${index}+1")
endmacro()

execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${repository}" rev-parse HEAD
    OUTPUT_VARIABLE app_commit OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
# Only tracked build/source/test/license materials. No .git, agent logs, local
# configuration, credentials, caches, receipts or personal environment dumps.
set(archive_paths CMakeLists.txt CMakePresets.json LICENSE THIRD_PARTY_NOTICES.md README.md src tests tools cmake patches docs/dev spec)
source_archive(SmoothMail "${repository}" "${app_commit}")
unset(archive_paths)

foreach(id IN ITEMS kcodecs kconfig kcoreaddons kcrash ki18n kio kmime kservice kimap ksmtp qtkeychain cyrus-sasl-xoauth2 extra-cmake-modules ninja vcpkg-recipes)
    string(JSON commit GET "${dependencies}" "${id}" commit)
    source_archive("${id}" "${DEPENDENCY_ROOT}/src/${id}" "${commit}")
endforeach()
foreach(id IN ITEMS qtbase qtsvg)
    if(id STREQUAL qtbase)
        set(commit 025bdad181de241e81bf853c8a2d7bf3d19261a9)
    else()
        set(commit 883a58532078d003cefef0a549bfe9f885ce41f5)
    endif()
    if(EXISTS "${DEPENDENCY_ROOT}/qt-license-sources/${id}/LICENSES")
        source_archive("${id}" "${DEPENDENCY_ROOT}/qt-license-sources/${id}" "${commit}")
    else()
        string(JSON inventory SET "${inventory}" missing ${missing_index} "\"${id}: fixed source not available\"")
        math(EXPR missing_index "${missing_index}+1")
    endif()
endforeach()

foreach(id IN ITEMS cyrus-sasl libiconv gettext)
    if(id STREQUAL cyrus-sasl)
        set(name cyrus-sasl-2.1.28.tar.gz)
        set(from "${DEPENDENCY_ROOT}/downloads/${name}")
        set(hash_kind SHA256)
        set(expected 7ccfc6abd01ed67c1a0924b353e526f1b766b21f42d4562ee635a8ebfc5bb38c)
    elseif(id STREQUAL libiconv)
        set(name libiconv-1.19.tar.gz)
        set(from "${DEPENDENCY_ROOT}/src/vcpkg-recipes/downloads/${name}")
        set(hash_kind SHA512)
        set(expected 1e8150f9bca907579330cd9c44ebbee46a260271fbe8f50d5ee24a39ef29c8d254505e85c3409324f7440596da711a8bd49e89f848a6be0cb3238a58c24aaecd)
    else()
        set(name gettext-0.22.5.tar.gz)
        set(from "${DEPENDENCY_ROOT}/src/vcpkg-recipes/downloads/${name}")
        set(hash_kind SHA512)
        set(expected d8b22d7fba10052a2045f477f0a5b684d932513bdb3b295c22fbd9dfc2a9d8fccd9aefd90692136c62897149aa2f7d1145ce6618aa1f0be787cb88eba5bc09be)
    endif()
    if(NOT EXISTS "${from}")
        message(FATAL_ERROR "Missing original source archive: ${name}")
    endif()
    file(${hash_kind} "${from}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Original source archive digest mismatch.")
    endif()
    file(COPY_FILE "${from}" "${OUTPUT}/${name}")
    file(SHA256 "${OUTPUT}/${name}" digest)
    string(JSON inventory SET "${inventory}" archives ${index}
        "{\"component\":\"${id}\",\"file\":\"${name}\",\"sha256\":\"${digest}\"}")
    math(EXPR index "${index}+1")
endforeach()
file(WRITE "${OUTPUT}/source-manifest.review.json" "${inventory}\n")
file(WRITE "${OUTPUT}/README.txt"
    "SOURCE REVIEW ONLY - NOT APPROVED AS COMPLETE CORRESPONDING SOURCE.\n\nPublish the final reviewed source artifacts on the SAME page as their matching binary download, not as an unfulfilled written offer.\nSmoothMail commit: ${app_commit}\nConfigure an exported tree with -DSMOOTHMAIL_SOURCE_COMMIT=${app_commit}.\n\nKDE archives are pinned upstream source. Apply the active patches using the SmoothMail cmake build scripts; patches, build settings and explanations are in the SmoothMail archive. vcpkg port patches and GNU configuration are included. No new GNU source patch is claimed.\n\nMissing source modules: ${missing_index}. Even zero missing modules does not replace compiled-code license review, Qt third-party notice collection, ABI replacement tests and source-to-binary matching.\nSee docs/dev/distribution-legal-audit.md and docs/dev/distribution-source-delivery.md in the SmoothMail archive.\n")
message(STATUS "Created ${index} source review archives; missing Qt modules: ${missing_index}.")
