cmake_minimum_required(VERSION 3.30)
# Optional corresponding-source/ABI test. Never part of the normal SDK bootstrap.
if(NOT DEFINED QT_REBUILD_OUTPUT OR QT_REBUILD_OUTPUT STREQUAL "" OR NOT SMOOTHMAIL_SOURCE_ARCHIVES)
    message(FATAL_ERROR "Specify a new QT_REBUILD_OUTPUT and SMOOTHMAIL_SOURCE_ARCHIVES.")
endif()
set(CMAKE_BUILD_TYPE Release)
include("${CMAKE_CURRENT_LIST_DIR}/DependencyBuild.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/SourceArchives.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/QtSourceSettings.cmake")
get_filename_component(QT_REBUILD_OUTPUT "${QT_REBUILD_OUTPUT}" ABSOLUTE)
smoothmail_check_qt_review_output("${Qt6_ROOT}" "${QT_REBUILD_OUTPUT}")
get_filename_component(parent "${QT_REBUILD_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}")
file(LOCK "${QT_REBUILD_OUTPUT}.lock" GUARD PROCESS TIMEOUT 300)
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" script_hash)
file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/source-archives.json" pins_hash)
file(SHA256 "${msvc_compiler}" compiler_hash)
string(SHA256 profile "${script_hash};${pins_hash};${compiler_hash}")
set(receipt "${QT_REBUILD_OUTPUT}/smoothmail-qt-profile.sha256")
if(EXISTS "${QT_REBUILD_OUTPUT}")
    if(NOT EXISTS "${receipt}")
        message(FATAL_ERROR "Existing Qt output has no profile; nothing was overwritten.")
    endif()
    file(READ "${receipt}" installed)
    string(STRIP "${installed}" installed)
    if(NOT installed STREQUAL profile)
        message(FATAL_ERROR "Qt source build profile changed; choose a new output.")
    endif()
else()
    file(MAKE_DIRECTORY "${QT_REBUILD_OUTPUT}")
    file(WRITE "${receipt}" "${profile}\n")
endif()
set(qtbase_commit 025bdad181de241e81bf853c8a2d7bf3d19261a9)
set(qtsvg_commit 883a58532078d003cefef0a549bfe9f885ce41f5)
set(privacy "/experimental:deterministic /utf-8 /pathmap:\"${DEPENDENCY_ROOT}=SmoothMail-dependencies\" /pathmap:\"${QT_REBUILD_OUTPUT}=SmoothMail-Qt-build\"")
set(link_flags "/PDBALTPATH:smoothmail-qt.pdb /INCREMENTAL:NO /Brepro")
set(install "${QT_REBUILD_OUTPUT}/install")
foreach(module IN ITEMS qtbase qtsvg)
    smoothmail_import_source_archive("${module}" "${${module}_commit}" source)
    set(options)
    if(module STREQUAL qtbase)
        set(options -DINPUT_openssl=no -DFEATURE_schannel=ON -DINPUT_sqlite=qt)
    else()
        set(options "-DCMAKE_PREFIX_PATH=${install}" "-DQt6_ROOT=${install}")
    endif()
    smoothmail_dependency_command("${CMAKE_COMMAND}" -S "${source}" -B "${QT_REBUILD_OUTPUT}/build/${module}"
        -G Ninja "-DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}" -DCMAKE_BUILD_TYPE=Release
        "-DCMAKE_INSTALL_PREFIX=${install}" -DBUILD_SHARED_LIBS=ON
        -DQT_BUILD_TESTS=OFF -DQT_BUILD_EXAMPLES=OFF -DQT_GENERATE_SBOM=OFF
        "-DCMAKE_C_COMPILER=${msvc_compiler}" "-DCMAKE_CXX_COMPILER=${msvc_compiler}"
        "-DCMAKE_C_FLAGS=${privacy}" "-DCMAKE_CXX_FLAGS=${privacy}"
        "-DCMAKE_SHARED_LINKER_FLAGS=${link_flags}" "-DCMAKE_MODULE_LINKER_FLAGS=${link_flags}"
        "-DCMAKE_EXE_LINKER_FLAGS=${link_flags}" ${options})
    smoothmail_dependency_command("${CMAKE_COMMAND}" --build "${QT_REBUILD_OUTPUT}/build/${module}" --parallel 4)
    smoothmail_dependency_command("${CMAKE_COMMAND}" --install "${QT_REBUILD_OUTPUT}/build/${module}")
    smoothmail_validate_archive_source("${module}" "${source}" "${${module}_commit}")
endforeach()
file(WRITE "${QT_REBUILD_OUTPUT}/build-profile.review.json"
    "{\"schema\":1,\"review_only\":true,\"configuration\":\"Release\",\"qtbase_commit\":\"${qtbase_commit}\",\"qtsvg_commit\":\"${qtsvg_commit}\",\"tls_backend\":\"schannel\",\"openssl\":false,\"sqlite\":\"bundled\",\"source_pins_sha256\":\"${pins_hash}\",\"compiler_sha256\":\"${compiler_hash}\"}\n")
message(STATUS "Qt source review build complete in its independent prefix; not an SDK replacement or release approval.")
