include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/LicenseTemplates.cmake")

# Validate the concrete runtime being reviewed, not just the existence of
# license texts. The result remains review-only; no release approval is granted.
function(smoothmail_check_license_runtime evidence stage manifest crt_bin version_output records_output)
    if(NOT IS_DIRECTORY "${stage}" OR IS_SYMLINK "${stage}")
        message(FATAL_ERROR "Final license review requires a regular runtime STAGE.")
    endif()
    file(STRINGS "${evidence}/runtime-components-sha256.txt" inventory)
    set(files)
    set(assignments)
    foreach(row IN LISTS inventory)
        if(row MATCHES "^SHA256 ")
            continue()
        endif()
        if(NOT row MATCHES "^([0-9a-f]+)  ([A-Za-z0-9_./-]+)  ([A-Za-z0-9-]+)$")
            message(FATAL_ERROR "Invalid runtime evidence inventory.")
        endif()
        set(expected "${CMAKE_MATCH_1}")
        set(name "${CMAKE_MATCH_2}")
        set(component "${CMAKE_MATCH_3}")
        string(LENGTH "${expected}" length)
        if(NOT length EQUAL 64 OR name MATCHES "(^|/)\\.\\.?(/|$)" OR name IN_LIST files)
            message(FATAL_ERROR "Unsafe or duplicate runtime evidence entry.")
        endif()
        smoothmail_license_regular_file("${stage}" "${name}")
        file(SHA256 "${stage}/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Runtime bytes changed since license evidence collection.")
        endif()
        list(APPEND files "${name}")
        list(APPEND assignments "${component}:${name}")
    endforeach()
    set(expected_assignments)
    string(JSON count LENGTH "${manifest}" components)
    math(EXPR last "${count}-1")
    foreach(i RANGE 0 ${last})
        string(JSON id GET "${manifest}" components ${i} name)
        string(JSON n LENGTH "${manifest}" components ${i} binaries)
        math(EXPR end "${n}-1")
        foreach(j RANGE 0 ${end})
            string(JSON binary GET "${manifest}" components ${i} binaries ${j})
            list(APPEND expected_assignments "${id}:${binary}")
        endforeach()
    endforeach()
    list(SORT assignments)
    list(SORT expected_assignments)
    if(NOT assignments STREQUAL expected_assignments)
        message(FATAL_ERROR "Runtime inventory and license component assignments differ.")
    endif()
    file(GLOB_RECURSE actual_files LIST_DIRECTORIES FALSE RELATIVE "${stage}" "${stage}/*")
    list(SORT files)
    list(SORT actual_files)
    if(NOT files STREQUAL actual_files)
        message(FATAL_ERROR "Runtime has missing or unclassified files.")
    endif()
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/WindowsCrt.cmake")
    smoothmail_validate_crt_directory("${crt_bin}")
    smoothmail_prepare_crt_verifier(verifier)
    set(records "{\"schema\":1,\"review_only\":true,\"files\":[]}")
    set(index 0)
    set(crt_version "")
    foreach(name IN LISTS files)
        if(NOT name MATCHES "^(msvcp|vcruntime|concrt|vccorlib).*\\.dll$")
            continue()
        endif()
        execute_process(COMMAND "${verifier}" "${crt_bin}/${name}" "${stage}/${name}"
            "${crt_bin}/vcruntime140.dll" RESULT_VARIABLE result OUTPUT_VARIABLE text ERROR_VARIABLE error)
        if(NOT result STREQUAL "0" OR NOT text MATCHES "^version=([0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+) sha256=([0-9a-f]+)")
            message(FATAL_ERROR "CRT provenance/version verification failed for final license review.")
        endif()
        set(version "${CMAKE_MATCH_1}")
        set(hash "${CMAKE_MATCH_2}")
        if(NOT crt_version STREQUAL "" AND NOT version STREQUAL crt_version)
            message(FATAL_ERROR "Mixed CRT versions in final license review.")
        endif()
        set(crt_version "${version}")
        string(JSON records SET "${records}" files ${index}
            "{\"file\":\"${name}\",\"version\":\"${version}\",\"sha256\":\"${hash}\"}")
        math(EXPR index "${index}+1")
    endforeach()
    if(index EQUAL 0)
        message(FATAL_ERROR "Missing verified runtime CRT version.")
    endif()
    set("${version_output}" "${crt_version}" PARENT_SCOPE)
    set("${records_output}" "${records}" PARENT_SCOPE)
endfunction()
