include_guard(GLOBAL)

function(smoothmail_patch_git output working)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${working}" ${ARGN}
        OUTPUT_VARIABLE text OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Patched source command failed: git ${ARGN}")
    endif()
    set("${output}" "${text}" PARENT_SCOPE)
endfunction()

function(smoothmail_prepare_patched_source dependency pristine commit patch workspace output_variable)
    find_package(Git REQUIRED)
    file(SHA256 "${patch}" patch_hash)
    string(SUBSTRING "${patch_hash}" 0 16 patch_key)
    if(NOT dependency MATCHES "^[a-z0-9-]+$")
        message(FATAL_ERROR "Invalid patched dependency name.")
    endif()
    set(source "${workspace}/${dependency}-${commit}-${patch_key}")
    set(receipt "${source}.receipt.cmake")
    file(MAKE_DIRECTORY "${workspace}")
    if(NOT EXISTS "${source}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" clone --no-hardlinks --no-checkout
            "${pristine}" "${source}" RESULT_VARIABLE result)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "Cannot create the independent ${dependency} source copy.")
        endif()
        smoothmail_patch_git(unused "${source}" checkout --detach "${commit}")
        smoothmail_patch_git(unused "${source}" apply --check "${patch}")
        smoothmail_patch_git(unused "${source}" apply "${patch}")
        smoothmail_patch_git(diff "${source}" diff --no-ext-diff --no-textconv --binary)
        string(SHA256 diff_hash "${diff}")
        file(WRITE "${receipt}" "set(expected_diff_hash \"${diff_hash}\")\n")
    endif()
    if(NOT EXISTS "${receipt}")
        message(FATAL_ERROR "${dependency} copy has no receipt; inspect it or use a new workspace. Nothing was overwritten.")
    endif()
    # Read a digest, never execute receipt contents as CMake code.
    file(STRINGS "${receipt}" receipt_lines)
    if(NOT receipt_lines MATCHES "^set\\(expected_diff_hash \"([a-f0-9]+)\"\\)$")
        message(FATAL_ERROR "Invalid ${dependency} source receipt.")
    endif()
    set(expected_diff_hash "${CMAKE_MATCH_1}")
    smoothmail_patch_git(head "${source}" rev-parse HEAD)
    if(NOT head STREQUAL commit)
        message(FATAL_ERROR "${dependency} source HEAD changed; refusing to build.")
    endif()
    smoothmail_patch_git(staged "${source}" diff --cached --no-ext-diff --no-textconv --binary)
    smoothmail_patch_git(untracked "${source}" ls-files --others)
    smoothmail_patch_git(diff "${source}" diff --no-ext-diff --no-textconv --binary)
    string(SHA256 actual_diff_hash "${diff}")
    if(NOT staged STREQUAL "" OR NOT untracked STREQUAL "" OR NOT actual_diff_hash STREQUAL expected_diff_hash)
        message(FATAL_ERROR "${dependency} source copy was modified; refusing to overwrite or build it.")
    endif()
    smoothmail_patch_git(unused "${source}" apply --reverse --check "${patch}")
    set("${output_variable}" "${source}" PARENT_SCOPE)
endfunction()
