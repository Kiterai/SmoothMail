cmake_minimum_required(VERSION 3.30)

# Online integration check, deliberately not part of the offline CTest suite.
# Use a new, short directory from an MSVC x64 developer command prompt.
if(NOT WIN32)
    message(FATAL_ERROR "This verification requires Windows/MSVC x64.")
endif()
if(NOT DEFINED DEPENDENCY_ROOT OR DEPENDENCY_ROOT STREQUAL "")
    message(FATAL_ERROR "Specify a new DEPENDENCY_ROOT for clean dependency verification.")
endif()
get_filename_component(DEPENDENCY_ROOT "${DEPENDENCY_ROOT}" ABSOLUTE)
if(EXISTS "${DEPENDENCY_ROOT}" OR IS_SYMLINK "${DEPENDENCY_ROOT}")
    message(FATAL_ERROR "Clean verification requires a nonexistent DEPENDENCY_ROOT; nothing was replaced.")
endif()
if(NOT DEFINED Qt6_ROOT OR NOT EXISTS "${Qt6_ROOT}/lib/cmake/Qt6/Qt6Config.cmake")
    message(FATAL_ERROR "Specify the existing developer-supplied Qt SDK.")
endif()
find_program(compiler cl.exe REQUIRED)
find_program(nmake nmake.exe REQUIRED)
file(MAKE_DIRECTORY "${DEPENDENCY_ROOT}")
file(WRITE "${DEPENDENCY_ROOT}/clean-verification-started.txt" "Initially absent dependency root.\n")
set(SMOOTHMAIL_NATIVE_ROOT "${DEPENDENCY_ROOT}/native/gnu-runtime-v1")
set(SMOOTHMAIL_GETTEXT_TOOLS_ROOT "${DEPENDENCY_ROOT}/native")
unset(SMOOTHMAIL_NATIVE_PREFIX)

# Do not consult a caller's vcpkg download or binary cache. All secondary native
# assets still use BuildNativeDependencies' verified CMake x-script downloader.
set(ENV{VCPKG_DOWNLOADS} "${DEPENDENCY_ROOT}/downloads/vcpkg")
set(ENV{VCPKG_BINARY_SOURCES} clear)
set(ENV{VCPKG_DEFAULT_BINARY_CACHE} "${DEPENDENCY_ROOT}/binary-cache")
set(ENV{VCPKG_ROOT} "${DEPENDENCY_ROOT}/src/vcpkg-recipes")
unset(ENV{VCPKG_OVERLAY_PORTS})
unset(ENV{VCPKG_OVERLAY_TRIPLETS})
file(MAKE_DIRECTORY "$ENV{VCPKG_DOWNLOADS}" "$ENV{VCPKG_DEFAULT_BINARY_CACHE}")
set(ENV{GIT_TERMINAL_PROMPT} 0)
set(ENV{GCM_INTERACTIVE} never)
set(CMAKE_BUILD_TYPE Release)
unset(CMAKE_MAKE_PROGRAM)
include("${CMAKE_CURRENT_LIST_DIR}/DependencyBuild.cmake")

string(JSON count LENGTH "${manifest}")
math(EXPR last "${count} - 1")
set(sources "[]")
foreach(index RANGE 0 ${last})
    string(JSON name MEMBER "${manifest}" ${index})
    smoothmail_fetch_dependency("${name}" source)
    string(JSON commit GET "${manifest}" "${name}" commit)
    string(JSON entry SET "{}" name "\"${name}\"")
    string(JSON entry SET "${entry}" commit "\"${commit}\"")
    string(JSON sources SET "${sources}" ${index} "${entry}")
endforeach()

# This is an actual build, not merely a list of likely URLs or --only-downloads:
# it exercises vcpkg's lazy tool/MSYS downloads and every dependency stage.
include("${CMAKE_CURRENT_LIST_DIR}/BuildWindowsDependencies.cmake")

file(GLOB assets LIST_DIRECTORIES FALSE
    "${DEPENDENCY_ROOT}/downloads/vcpkg/*"
    "${DEPENDENCY_ROOT}/downloads/*.tar.gz"
    "${DEPENDENCY_ROOT}/src/vcpkg-recipes/vcpkg.exe")
set(downloads "[]")
set(index 0)
foreach(asset IN LISTS assets)
    if(asset MATCHES "\\.(lock|part)$")
        continue()
    endif()
    file(RELATIVE_PATH name "${DEPENDENCY_ROOT}" "${asset}")
    file(SHA512 "${asset}" digest)
    string(JSON entry SET "{}" file "\"${name}\"")
    string(JSON entry SET "${entry}" sha512 "\"${digest}\"")
    string(JSON downloads SET "${downloads}" ${index} "${entry}")
    math(EXPR index "${index} + 1")
endforeach()
file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/dependencies.json" source_manifest_hash)
file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/native-dependencies.json" native_manifest_hash)
set(receipt "{}")
string(JSON receipt SET "${receipt}" schema 1)
string(JSON receipt SET "${receipt}" configuration "\"Release\"")
string(JSON receipt SET "${receipt}" initial_root_absent true)
string(JSON receipt SET "${receipt}" binary_cache_disabled true)
string(JSON receipt SET "${receipt}" dependency_stages_completed true)
string(JSON receipt SET "${receipt}" cmake_version "\"${CMAKE_VERSION}\"")
string(JSON receipt SET "${receipt}" source_manifest_sha256 "\"${source_manifest_hash}\"")
string(JSON receipt SET "${receipt}" native_manifest_sha256 "\"${native_manifest_hash}\"")
string(JSON receipt SET "${receipt}" sources "${sources}")
string(JSON receipt SET "${receipt}" verified_download_inventory "${downloads}")
file(WRITE "${DEPENDENCY_ROOT}/clean-verification-completed.json" "${receipt}\n")
message(STATUS "Clean Release dependency verification completed (${count} pinned Git sources).")
