include_guard(GLOBAL)

function(smoothmail_license_regular_file base relative)
    if(relative STREQUAL "" OR relative MATCHES "(^/|\\\\|:|(^|/)\\.\\.(/|$)|[;\r\n])")
        message(FATAL_ERROR "Unsafe evidence reference.")
    endif()
    file(REAL_PATH "${base}" real_base)
    file(REAL_PATH "${base}/${relative}" real_file)
    cmake_path(IS_PREFIX real_base "${real_file}" NORMALIZE contained)
    if(NOT contained OR NOT EXISTS "${real_file}" OR IS_DIRECTORY "${real_file}"
            OR IS_SYMLINK "${base}/${relative}")
        message(FATAL_ERROR "Missing or linked evidence reference.")
    endif()
endfunction()

# Deliberately a data parser, not a shell/dotenv evaluator. Never log values:
# an accidentally supplied application .env could contain credentials.
function(smoothmail_read_license_env path)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
        message(FATAL_ERROR "Specify an existing regular license ENV_FILE; see .env.example.")
    endif()
    file(STRINGS "${path}" lines ENCODING UTF-8)
    set(required SOFTWARE_NAME DISTRIBUTION_URL BUILD_VERSION)
    set(keys ${required} SMOOTHMAIL_GOOGLE_CLIENT_ID SMOOTHMAIL_GOOGLE_CLIENT_SECRET SMOOTHMAIL_MICROSOFT_CLIENT_ID
        SMOOTHMAIL_QT_ROOT SMOOTHMAIL_DEPENDENCY_ROOT SMOOTHMAIL_CRT_BIN SMOOTHMAIL_DOWNLOAD_CURL
        SMOOTHMAIL_SOURCE_ARCHIVES SMOOTHMAIL_SOURCE_COMMIT SMOOTHMAIL_ASSET_CACHE)
    foreach(key IN LISTS keys)
        set("${key}" "")
    endforeach()
    set(seen)
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        if(line STREQUAL "" OR line MATCHES "^#")
            continue()
        endif()
        if(NOT line MATCHES "^([A-Z_]+)=(.*)$")
            message(FATAL_ERROR "Invalid license environment assignment.")
        endif()
        set(key "${CMAKE_MATCH_1}")
        set(value "${CMAKE_MATCH_2}")
        if(NOT key IN_LIST keys OR key IN_LIST seen)
            message(FATAL_ERROR "Unknown or duplicate license environment key.")
        endif()
        list(APPEND seen "${key}")
        string(STRIP "${value}" value)
        if(value MATCHES "^\"(.*)\"$")
            set(value "${CMAKE_MATCH_1}")
        elseif(value MATCHES "^'(.*)'$")
            set(value "${CMAKE_MATCH_1}")
        endif()
        if((value STREQUAL "" AND key IN_LIST required) OR value MATCHES "[\r\n\t]")
            message(FATAL_ERROR "Empty or multiline license environment value.")
        endif()
        foreach(forbidden IN ITEMS ";" "`" "<" ">" "\\" "#" "*" "[" "]" "@" "\${" "\"" "'")
            string(FIND "${value}" "${forbidden}" position)
            if(NOT position EQUAL -1)
                message(FATAL_ERROR "Unsafe license environment value; expansion is not supported.")
            endif()
        endforeach()
        set("${key}" "${value}")
    endforeach()
    foreach(key IN LISTS required)
        if(NOT key IN_LIST seen)
            message(FATAL_ERROR "Required license environment key is missing.")
        endif()
    endforeach()
    if(NOT DISTRIBUTION_URL MATCHES "^https://[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]+)?([/?][A-Za-z0-9._~/?&=%+-]*)?$")
        message(FATAL_ERROR "License distribution URL must be a plain HTTPS URL without credentials.")
    endif()
    foreach(key IN LISTS keys)
        set("${key}" "${${key}}" PARENT_SCOPE)
    endforeach()
endfunction()

function(smoothmail_render_license_template template output)
    set(NOTICE_STATUS_EN "Draft for review. ")
    set(NOTICE_STATUS_JA "審査用草案。")
    set(REVIEW_BANNER_EN "**Draft for review; not approved for distribution.**")
    set(REVIEW_BANNER_JA "**審査用草案。配布未承認。**")
    if(LICENSE_FINAL_REVIEW)
        set(NOTICE_STATUS_EN "")
        set(NOTICE_STATUS_JA "")
        set(REVIEW_BANNER_EN "")
        set(REVIEW_BANNER_JA "")
    endif()
    file(READ "${template}" text)
    string(REGEX MATCHALL "@[A-Za-z_][A-Za-z0-9_]*@" placeholders "${text}")
    set(allowed SOFTWARE_NAME DISTRIBUTION_URL BUILD_VERSION EDITION
        COMPONENT_ROWS SOURCE_ROWS COMPONENT_NAME COMPONENT_VERSION BINARY_LIST LICENSE_LIST SOURCE_DETAILS
        NOTICE_STATUS_EN NOTICE_STATUS_JA REVIEW_BANNER_EN REVIEW_BANNER_JA)
    foreach(placeholder IN LISTS placeholders)
        string(REGEX REPLACE "^@|@$" "" key "${placeholder}")
        if(NOT key IN_LIST allowed OR NOT DEFINED ${key})
            message(FATAL_ERROR "Unknown or unset license template variable.")
        endif()
    endforeach()
    string(CONFIGURE "${text}" rendered @ONLY)
    if(rendered MATCHES "@[A-Za-z_][A-Za-z0-9_]*@")
        message(FATAL_ERROR "Unresolved license template variable.")
    endif()
    # Only generated notices are normalized. Third-party originals are copied
    # separately and must remain byte-for-byte unchanged.
    string(REPLACE "\r\n" "\n" rendered "${rendered}")
    string(REGEX REPLACE "\n([ \t]*\n)+" "\n\n" rendered "${rendered}")
    file(WRITE "${output}" "${rendered}")
endfunction()
