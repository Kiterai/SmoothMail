include_guard(GLOBAL)

# File names as well as contents participate. No receipts inside a source tree,
# symlinks, generated Git repositories, or executable metadata are trusted.
function(smoothmail_source_tree_digest directory output)
    get_filename_component(directory "${directory}" ABSOLUTE)
    if(NOT IS_DIRECTORY "${directory}" OR IS_SYMLINK "${directory}")
        message(FATAL_ERROR "Missing or linked source tree.")
    endif()
    file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE RELATIVE "${directory}" "${directory}/*")
    list(SORT entries)
    set(inventory "")
    foreach(entry IN LISTS entries)
        if(entry MATCHES "[;\r\n]|(^|/)\\.git(/|$)" OR IS_SYMLINK "${directory}/${entry}")
            message(FATAL_ERROR "Unsafe source tree entry.")
        endif()
        if(NOT IS_DIRECTORY "${directory}/${entry}")
            file(SHA256 "${directory}/${entry}" digest)
            string(APPEND inventory "${entry} ${digest}\n")
        endif()
    endforeach()
    if(inventory STREQUAL "")
        message(FATAL_ERROR "Empty source tree.")
    endif()
    string(SHA256 digest "${inventory}")
    set(${output} "${digest}" PARENT_SCOPE)
endfunction()

function(smoothmail_archive_pin dependency commit archive_hash tree_hash)
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/source-archives.json" pins)
    foreach(field IN ITEMS commit sha256 tree_sha256)
        string(JSON value ERROR_VARIABLE error GET "${pins}" "${dependency}" "${field}")
        if(NOT error STREQUAL "NOTFOUND")
            message(FATAL_ERROR "Missing reviewed source archive pin: ${dependency}.")
        endif()
        set(pin_${field} "${value}")
    endforeach()
    if(NOT pin_commit STREQUAL commit)
        message(FATAL_ERROR "Source archive pin does not match the dependency revision.")
    endif()
    foreach(field IN ITEMS sha256 tree_sha256)
        string(LENGTH "${pin_${field}}" length)
        if(NOT length EQUAL 64 OR NOT pin_${field} MATCHES "^[0-9a-f]+$")
            message(FATAL_ERROR "Invalid reviewed source digest.")
        endif()
    endforeach()
    set(${archive_hash} "${pin_sha256}" PARENT_SCOPE)
    set(${tree_hash} "${pin_tree_sha256}" PARENT_SCOPE)
endfunction()

function(smoothmail_validate_archive_source dependency directory commit)
    smoothmail_archive_pin("${dependency}" "${commit}" archive_hash expected)
    smoothmail_source_tree_digest("${directory}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Archived source tree was modified: ${dependency}. Choose a new source/build directory.")
    endif()
endfunction()

function(smoothmail_import_source_archive dependency commit output)
    if(NOT dependency MATCHES "^[a-z0-9-]+$" OR NOT IS_DIRECTORY "${SMOOTHMAIL_SOURCE_ARCHIVES}")
        message(FATAL_ERROR "Specify a source archive directory.")
    endif()
    smoothmail_archive_pin("${dependency}" "${commit}" expected tree_hash)
    get_filename_component(archive_directory "${SMOOTHMAIL_SOURCE_ARCHIVES}" ABSOLUTE)
    get_filename_component(dependency_root "${DEPENDENCY_ROOT}" ABSOLUTE)
    set(archive "${archive_directory}/${dependency}-${commit}.tar")
    if(NOT EXISTS "${archive}" OR IS_DIRECTORY "${archive}" OR IS_SYMLINK "${archive}")
        message(FATAL_ERROR "Missing regular source archive: ${dependency}. No Git/network fallback is allowed in archive mode.")
    endif()
    file(SHA256 "${archive}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Source archive checksum differs from the reviewed pin: ${dependency}.")
    endif()
    set(parent "${dependency_root}/archive-src")
    if(IS_SYMLINK "${parent}")
        message(FATAL_ERROR "Linked archive source workspace.")
    endif()
    set(source "${parent}/${dependency}-${commit}")
    file(MAKE_DIRECTORY "${parent}")
    file(LOCK "${source}.lock" GUARD FUNCTION TIMEOUT 300)
    if(NOT EXISTS "${source}" AND NOT IS_SYMLINK "${source}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}"
            OUTPUT_VARIABLE names RESULT_VARIABLE result)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "Cannot list source archive.")
        endif()
        string(REPLACE "\r\n" "\n" names "${names}")
        string(REPLACE "\n" ";" names "${names}")
        foreach(name IN LISTS names)
            if(name STREQUAL "")
                continue()
            endif()
            string(FIND "${name}" "${dependency}/" starts)
            if(NOT starts EQUAL 0 OR name MATCHES "\\\\|:|(^|/)\\.\\.(/|$)|(^|/)\\.git(/|$)")
                message(FATAL_ERROR "Unsafe source archive layout.")
            endif()
        endforeach()
        string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
        set(temporary "${parent}/extract-${nonce}")
        file(MAKE_DIRECTORY "${temporary}")
        # Only the reviewed archive bytes reach extraction. Reviewed sources
        # must contain no links; the tree pin also detects omitted/extra files.
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${temporary}")
        smoothmail_validate_archive_source("${dependency}" "${temporary}/${dependency}" "${commit}")
        file(RENAME "${temporary}/${dependency}" "${source}" NO_REPLACE RESULT result)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "Cannot publish imported source without replacement.")
        endif()
        file(REMOVE_RECURSE "${temporary}")
    endif()
    smoothmail_validate_archive_source("${dependency}" "${source}" "${commit}")
    set(${output} "${source}" PARENT_SCOPE)
endfunction()

function(smoothmail_prepare_archive_patch dependency pristine commit patch source)
    find_package(Git REQUIRED)
    smoothmail_validate_archive_source("${dependency}" "${pristine}" "${commit}")
    get_filename_component(workspace "${source}" DIRECTORY)
    file(MAKE_DIRECTORY "${workspace}")
    file(LOCK "${source}.lock" GUARD FUNCTION TIMEOUT 300)
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(temporary "${workspace}/patch-${dependency}-${nonce}")
    file(MAKE_DIRECTORY "${temporary}")
    file(COPY "${pristine}/" DESTINATION "${temporary}")
    # Prevent Git from discovering a builder's enclosing repository. Do not
    # manufacture commit identities or disable the upstream Git-mode guards.
    foreach(arguments IN ITEMS --check --apply)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env
            --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE
            "GIT_CEILING_DIRECTORIES=${workspace}"
            "${GIT_EXECUTABLE}" -C "${temporary}" apply "${arguments}" "${patch}"
            RESULT_VARIABLE result)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "Cannot apply reviewed patch to archived source.")
        endif()
    endforeach()
    smoothmail_source_tree_digest("${temporary}" expected)
    if(EXISTS "${source}" OR IS_SYMLINK "${source}")
        smoothmail_source_tree_digest("${source}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Patched archive tree was modified; nothing was overwritten.")
        endif()
        file(REMOVE_RECURSE "${temporary}")
    else()
        file(RENAME "${temporary}" "${source}" NO_REPLACE RESULT result)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "Cannot publish patched archive tree.")
        endif()
    endif()
endfunction()
