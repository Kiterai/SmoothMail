include_guard(GLOBAL)

function(smoothmail_qt_attribution_files source attribution item output)
    set(references)
    foreach(field IN ITEMS LicenseFile CopyrightFile LicenseFiles CopyrightFiles)
        string(JSON kind ERROR_VARIABLE error TYPE "${item}" "${field}")
        if(NOT error STREQUAL "NOTFOUND")
            continue()
        endif()
        if(field MATCHES "Files$")
            if(NOT kind STREQUAL ARRAY)
                message(FATAL_ERROR "Qt attribution file list must be an array.")
            endif()
            string(JSON count LENGTH "${item}" "${field}")
            if(count GREATER 0)
                math(EXPR last "${count}-1")
                foreach(i RANGE 0 ${last})
                    string(JSON entry_kind TYPE "${item}" "${field}" ${i})
                    if(NOT entry_kind STREQUAL STRING)
                        message(FATAL_ERROR "Qt attribution file reference must be a string.")
                    endif()
                    string(JSON reference GET "${item}" "${field}" ${i})
                    list(APPEND references "${reference}")
                endforeach()
            endif()
        else()
            if(NOT kind STREQUAL STRING)
                message(FATAL_ERROR "Qt attribution file reference must be a string.")
            endif()
            string(JSON reference GET "${item}" "${field}")
            if(NOT reference STREQUAL "")
                list(APPEND references "${reference}")
            endif()
        endif()
    endforeach()
    get_filename_component(directory "${attribution}" DIRECTORY)
    file(REAL_PATH "${source}" base)
    set(files)
    foreach(reference IN LISTS references)
        if(reference MATCHES "[;\r\n]|^[/\\\\]|:")
            message(FATAL_ERROR "Unsafe Qt attribution file reference.")
        endif()
        file(REAL_PATH "${directory}/${reference}" resolved)
        cmake_path(IS_PREFIX base "${resolved}" NORMALIZE inside)
        if(NOT inside OR NOT EXISTS "${resolved}" OR IS_DIRECTORY "${resolved}"
                OR IS_SYMLINK "${directory}/${reference}")
            message(FATAL_ERROR "Missing or unsafe Qt attribution file reference.")
        endif()
        list(APPEND files "${resolved}")
    endforeach()
    list(REMOVE_DUPLICATES files)
    set("${output}" "${files}" PARENT_SCOPE)
endfunction()
