cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/DependencyBuild.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PreparePatchedSource.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ModifiedDependencyReceipt.cmake")
if(NOT WIN32)
    message(FATAL_ERROR "The no-update KConfig bootstrap is for Windows only.")
endif()
smoothmail_fetch_dependency(kconfig pristine)
string(JSON commit GET "${manifest}" kconfig commit)
get_filename_component(patch "${CMAKE_CURRENT_LIST_DIR}/../patches/kconfig/6.31.0-optional-check-update.patch" ABSOLUTE)
smoothmail_prepare_patched_source(kconfig "${pristine}" "${commit}" "${patch}" "${DEPENDENCY_ROOT}/patched-src" source)
file(SHA256 "${patch}" patch_hash)
string(SUBSTRING "${patch_hash}" 0 16 patch_key)
set(binary "${DEPENDENCY_ROOT}/build/${CMAKE_BUILD_TYPE}/kconfig-no-update-${patch_key}")
smoothmail_build_dependency_source(kconfig "${source}" "${binary}"
    -DKCONFIG_USE_QML=OFF -DKCONFIG_USE_KCONF_UPDATE=OFF -DCMAKE_EXPORT_COMPILE_COMMANDS=ON)
file(READ "${binary}/src/core/config-kconfig.h" configuration)
file(READ "${binary}/compile_commands.json" commands)
if(NOT configuration MATCHES "#define KCONFIG_USE_KCONF_UPDATE 0"
        OR commands MATCHES "KCONF_UPDATE_INSTALL_LOCATION")
    message(FATAL_ERROR "KConfig external migration was not disabled; refusing to write its receipt.")
endif()
set(notices "${prefix}/share/licenses/kconfig")
file(MAKE_DIRECTORY "${notices}")
file(COPY "${pristine}/LICENSES" "${patch}" "${CMAKE_CURRENT_LIST_DIR}/../patches/kconfig/README.md"
    DESTINATION "${notices}")
smoothmail_write_modified_receipt("${notices}" "${prefix}/bin/KF6ConfigCore.dll" "${commit}" "${patch}")
