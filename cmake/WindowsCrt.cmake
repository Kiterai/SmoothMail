include_guard(GLOBAL)

function(smoothmail_validate_crt_directory directory)
    file(REAL_PATH "${directory}" real)
    string(TOLOWER "${real}" lower)
    if(NOT IS_DIRECTORY "${real}" OR IS_SYMLINK "${directory}" OR
            NOT lower MATCHES "/vc/redist/msvc/[^/]+/x64/microsoft\\.vc143\\.crt$")
        message(FATAL_ERROR "CRT_BIN must be the installed VS 2022 x64 Release VC143 redistributable directory.")
    endif()
endfunction()

function(smoothmail_parse_imports text output)
    # DUMPBIN /DEPENDENTS lists both ordinary and delay-load imports as DLL
    # basenames on indented lines. Do not interpret paths or command output as code.
    string(TOLOWER "${text}" text)
    string(REGEX MATCHALL "[\r\n][ \t]+[a-z0-9_.-]+\\.dll" lines "\n${text}")
    set(names)
    foreach(line IN LISTS lines)
        string(STRIP "${line}" name)
        list(APPEND names "${name}")
    endforeach()
    list(REMOVE_DUPLICATES names)
    set(${output} "${names}" PARENT_SCOPE)
endfunction()

function(smoothmail_crt_imports file output)
    execute_process(COMMAND "${DUMPBIN}" /DEPENDENTS "${file}"
        RESULT_VARIABLE result OUTPUT_VARIABLE text ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Cannot inspect Release imports.")
    endif()
    smoothmail_parse_imports("${text}" names)
    set(${output} "${names}" PARENT_SCOPE)
endfunction()

function(smoothmail_collect_crt directory roots output)
    smoothmail_validate_crt_directory("${directory}")
    set(queue ${roots})
    set(visited)
    set(crt_files)
    while(queue)
        list(POP_FRONT queue binary)
        if(binary IN_LIST visited)
            continue()
        endif()
        list(APPEND visited "${binary}")
        smoothmail_crt_imports("${binary}" imports)
        foreach(name IN LISTS imports)
            if(name STREQUAL "msvcp_win.dll")
                # Windows' own C++ support library, not a VC redistributable.
                continue()
            endif()
            if(name MATCHES "^(ucrtbased|msvcp.*d(_.*)?|vcruntime.*d|concrt.*d|vccorlib.*d)\\.dll$")
                message(FATAL_ERROR "Debug CRT import is not distributable.")
            endif()
            if(name MATCHES "^(msvcp|vcruntime|concrt|vccorlib)[a-z0-9_]*\\.dll$")
                if(NOT name MATCHES "^(msvcp140(_[12]|_atomic_wait|_codecvt_ids)?|vcruntime140(_1|_threads)?|concrt140|vccorlib140)\\.dll$")
                    message(FATAL_ERROR "Unreviewed MSVC runtime import.")
                endif()
                set(file "${directory}/${name}")
                if(NOT EXISTS "${file}" OR IS_SYMLINK "${file}")
                    message(FATAL_ERROR "Required CRT import is missing from CRT_BIN: ${name}")
                endif()
                file(REAL_PATH "${file}" real)
                file(REAL_PATH "${directory}" base)
                get_filename_component(parent "${real}" DIRECTORY)
                if(NOT parent STREQUAL base)
                    message(FATAL_ERROR "CRT import escapes CRT_BIN.")
                endif()
                if(NOT file IN_LIST crt_files)
                    list(APPEND crt_files "${file}")
                    list(APPEND queue "${file}")
                endif()
            endif()
        endforeach()
    endwhile()
    if(NOT crt_files)
        message(FATAL_ERROR "No required Release CRT imports found.")
    endif()
    list(SORT crt_files)
    set(${output} "${crt_files}" PARENT_SCOPE)
endfunction()

function(smoothmail_prepare_crt_verifier output)
    get_filename_component(repository "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    file(SHA256 "${repository}/tools/windows-crt/verify.cpp" source_hash)
    file(SHA256 "${repository}/tools/windows-crt/CMakeLists.txt" cmake_hash)
    string(SHA256 key "${source_hash};${cmake_hash}")
    # A full SHA256 in the directory name can push MSVC's compiler probes
    # beyond MAX_PATH when building from an extracted source bundle.
    string(SUBSTRING "${key}" 0 16 short_key)
    set(binary "${repository}/build/tools/crt-v2-${short_key}")
    file(MAKE_DIRECTORY "${repository}/build/tools")
    file(LOCK "${binary}.lock" GUARD FUNCTION TIMEOUT 300)
    file(MAKE_DIRECTORY "${binary}")
    set(key_file "${binary}/source-key.txt")
    if(EXISTS "${key_file}")
        file(READ "${key_file}" cached_key)
        if(NOT cached_key STREQUAL key)
            message(FATAL_ERROR "CRT verifier cache identity collision; refusing reuse.")
        endif()
    endif()
    file(WRITE "${key_file}" "${key}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${repository}/tools/windows-crt"
        -B "${binary}" -G "NMake Makefiles" -DCMAKE_BUILD_TYPE=Release
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Cannot configure CRT verifier: ${out}\n${err}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${binary}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Cannot build CRT verifier: ${out}\n${err}")
    endif()
    set(${output} "${binary}/smoothmail_crt_verify.exe" PARENT_SCOPE)
endfunction()
