set(SMOOTHMAIL_LEGAL_DIR "" CACHE PATH "Reviewed legal directory to embed in the About dialog")
set(SMOOTHMAIL_SOURCE_COMMIT "" CACHE STRING "Source commit identity for exported source trees without Git")
set(license_output "${CMAKE_CURRENT_BINARY_DIR}/license-resources")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE" "${CMAKE_CURRENT_SOURCE_DIR}/THIRD_PARTY_NOTICES.md")
file(MAKE_DIRECTORY "${license_output}")
set(catalog "[]")
set(license_files)

function(smoothmail_license_entry title text)
    string(JSON count LENGTH "${catalog}")
    set(name "entry-${count}.txt")
    file(WRITE "${license_output}/${name}" "${text}")
    string(REPLACE "\\" "\\\\" title "${title}")
    string(REPLACE "\"" "\\\"" title "${title}")
    string(JSON next SET "${catalog}" ${count} "{\"title\":\"${title}\",\"file\":\"${name}\"}")
    set(catalog "${next}" PARENT_SCOPE)
    set(license_files ${license_files} "${license_output}/${name}" PARENT_SCOPE)
endfunction()

file(READ "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE" text)
smoothmail_license_entry("SmoothMail / MIT" "${text}")
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/THIRD_PARTY_NOTICES.md" text)
smoothmail_license_entry("第三者コード・変更通知" "${text}")

if(SMOOTHMAIL_LEGAL_DIR)
    get_filename_component(SMOOTHMAIL_LEGAL_DIR "${SMOOTHMAIL_LEGAL_DIR}" ABSOLUTE)
    if(EXISTS "${SMOOTHMAIL_LEGAL_DIR}/manifest.json")
        set(license_manifest "${SMOOTHMAIL_LEGAL_DIR}/manifest.json")
        set(license_status "配布用ライセンス資料。ソースはバイナリと同じ配布ページで別途提供します。")
    elseif(EXISTS "${SMOOTHMAIL_LEGAL_DIR}/manifest.review.json" AND NOT SMOOTHMAIL_DISTRIBUTION)
        set(license_manifest "${SMOOTHMAIL_LEGAL_DIR}/manifest.review.json")
        set(license_status "開発・レビュー用です。未収集・未監査の原文があり、配布承認を意味しません。ソースはバイナリと同じ配布ページで別途提供する方針です。")
    else()
        message(FATAL_ERROR "Missing release legal manifest (review input is not allowed for distribution).")
    endif()
    file(READ "${license_manifest}" manifest)
    string(JSON review_type ERROR_VARIABLE review_error TYPE "${manifest}" review_only)
    if(SMOOTHMAIL_DISTRIBUTION AND review_error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Review-only metadata cannot be embedded as approved release legal input.")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${license_manifest}")
    string(JSON component_count LENGTH "${manifest}" components)
    math(EXPR component_last "${component_count}-1")
    foreach(i RANGE 0 ${component_last})
        string(JSON name GET "${manifest}" components ${i} name)
        string(JSON version ERROR_VARIABLE version_error GET "${manifest}" components ${i} version)
        if(NOT version_error STREQUAL "NOTFOUND")
            set(version "版情報未記載")
        endif()
        string(JSON notice GET "${manifest}" components ${i} source_notice)
        string(JSON count LENGTH "${manifest}" components ${i} license_files)
        if(SMOOTHMAIL_DISTRIBUTION AND count EQUAL 0)
            message(FATAL_ERROR "Missing component license text.")
        endif()
        set(paths "${notice}")
        if(count GREATER 0)
            math(EXPR last "${count}-1")
            foreach(j RANGE 0 ${last})
                string(JSON path GET "${manifest}" components ${i} license_files ${j})
                list(APPEND paths "${path}")
            endforeach()
        endif()
        set(text "${name} ${version}\n\n")
        if(count EQUAL 0)
            string(APPEND text "ライセンス原文未収集・監査未完了。配布承認済みではありません。\n\n")
        endif()
        foreach(path IN LISTS paths)
            if(path MATCHES "(^/|\\\\|:|(^|/)\\.\\.(/|$)|(^|/)\\.(/|$))")
                message(FATAL_ERROR "Unsafe license resource path.")
            endif()
            set(full "${SMOOTHMAIL_LEGAL_DIR}/${path}")
            file(REAL_PATH "${SMOOTHMAIL_LEGAL_DIR}" base)
            file(REAL_PATH "${full}" resolved)
            string(FIND "${resolved}" "${base}/" inside)
            if(NOT inside EQUAL 0 OR NOT EXISTS "${full}" OR IS_SYMLINK "${full}")
                message(FATAL_ERROR "Missing or linked license resource.")
            endif()
            file(READ "${full}" content)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${full}")
            string(APPEND text "----- ${path} -----\n${content}\n\n")
        endforeach()
        smoothmail_license_entry("${name} ${version}" "${text}")
    endforeach()
elseif(SMOOTHMAIL_DISTRIBUTION)
    message(FATAL_ERROR "Distribution requires SMOOTHMAIL_LEGAL_DIR for embedded license notices.")
else()
    set(license_status "開発ビルドです。第三者ライセンス原文一式は未設定です。配布監査が完了したものではありません。ソースはバイナリと同じ配布ページで別途提供する方針です。")
endif()
smoothmail_license_entry("ライセンス資料・ソース提供について" "${license_status}")
file(WRITE "${license_output}/catalog.json" "${catalog}\n")
qt_add_resources(smoothmail_ui smoothmail_licenses PREFIX "/licenses"
    BASE "${license_output}" FILES ${license_files} "${license_output}/catalog.json")

find_package(Git QUIET)
set(source_identity "${SMOOTHMAIL_SOURCE_COMMIT}")
if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/.git" AND Git_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_CURRENT_SOURCE_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE source_identity OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE git_result)
    if(NOT git_result EQUAL 0)
        message(FATAL_ERROR "Cannot identify source commit.")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_CURRENT_SOURCE_DIR}" diff --quiet HEAD
        RESULT_VARIABLE source_dirty)
    if(NOT source_dirty EQUAL 0)
        string(APPEND source_identity "-dirty")
    endif()
endif()
if(NOT source_identity MATCHES "^[0-9a-f]+(-dirty)?$")
    set(source_identity "不明（ソース識別情報未設定）")
endif()
string(LENGTH "${source_identity}" source_identity_length)
if(SMOOTHMAIL_DISTRIBUTION AND (NOT source_identity MATCHES "^[0-9a-f]+$"
        OR NOT source_identity_length MATCHES "^(40|64)$"))
    message(FATAL_ERROR "Distribution requires a clean committed source identity matching the separately supplied source.")
endif()
string(TIMESTAMP source_build_date "%Y-%m-%d" UTC)
target_compile_definitions(smoothmail_ui PRIVATE
    SMOOTHMAIL_VERSION="${PROJECT_VERSION}"
    SMOOTHMAIL_BUILD_DATE="${source_build_date}"
    SMOOTHMAIL_SOURCE_ID="${source_identity}")
