include("${CMAKE_CURRENT_LIST_DIR}/ModifiedDependencyReceipt.cmake")
if(NOT CMAKE_BUILD_TYPE)
    message(FATAL_ERROR "Choose a single build configuration (for example the Ninja dev preset).")
endif()
string(TOUPPER "${CMAKE_BUILD_TYPE}" configuration)
if(CMAKE_BUILD_TYPE STREQUAL Debug)
    set(qt_configuration DEBUG)
else()
    set(qt_configuration RELEASE)
endif()
get_target_property(qtcore Qt6::Core "IMPORTED_LOCATION_${qt_configuration}")
file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies.json" dependency_manifest)
set(modified_dependencies kio kimap ksmtp kmime kcodecs)
if(WIN32)
    list(APPEND modified_dependencies kconfig kcrash)
endif()
foreach(dependency IN LISTS modified_dependencies)
    if(dependency STREQUAL kio)
        set(target KF6::KIOCore)
        if(WIN32)
            set(patch "${CMAKE_CURRENT_LIST_DIR}/../patches/kio/6.31.0-smoothmail-portable-core.patch")
        else()
            set(patch "${CMAKE_CURRENT_LIST_DIR}/../patches/kio/6.31.0-disable-favicon-cache.patch")
        endif()
    elseif(dependency STREQUAL kimap)
        set(target KPim6::IMAP)
        set(patch "${CMAKE_CURRENT_LIST_DIR}/../patches/kimap/26.08.3-fix-sasl-continuation.patch")
    elseif(dependency STREQUAL ksmtp)
        set(target KPim6::SMTP)
        set(patch "${CMAKE_CURRENT_LIST_DIR}/../patches/ksmtp/26.08.3-reset-ehlo-capabilities.patch")
    elseif(dependency STREQUAL kmime)
        set(target KF6::Mime)
        set(patch "${CMAKE_CURRENT_LIST_DIR}/../patches/kmime/6.31.0-safe-ctype.patch")
    elseif(dependency STREQUAL kcrash)
        set(target KF6::Crash)
        set(patch "${CMAKE_CURRENT_LIST_DIR}/../patches/kcrash/6.31.0-windows-runtime-paths.patch")
    elseif(dependency STREQUAL kconfig)
        set(target KF6::ConfigCore)
        set(patch "${CMAKE_CURRENT_LIST_DIR}/../patches/kconfig/6.31.0-optional-check-update.patch")
    else()
        set(target KF6::Codecs)
        set(patch "${CMAKE_CURRENT_LIST_DIR}/../patches/kcodecs/6.31.0-safe-ctype.patch")
    endif()
    get_target_property(artifact "${target}" "IMPORTED_LOCATION_${configuration}")
    if(NOT artifact OR NOT qtcore)
        message(FATAL_ERROR "${target}/Qt lacks the requested ${CMAKE_BUILD_TYPE} configuration; do not mix Debug and Release dependencies.")
    endif()
    get_filename_component(binary_directory "${artifact}" DIRECTORY)
    get_filename_component(dependency_prefix "${binary_directory}" DIRECTORY)
    string(JSON commit GET "${dependency_manifest}" "${dependency}" commit)
    smoothmail_validate_modified_receipt("${dependency_prefix}/share/licenses/${dependency}/smoothmail-build.json"
        "${artifact}" "${qtcore}" "${commit}" "${patch}" "${CMAKE_BUILD_TYPE}")
endforeach()
