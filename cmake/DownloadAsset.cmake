include_guard(GLOBAL)

# Verified cache only; a failed transfer never becomes a reusable asset.
# CMake/libcurl honours the process HTTPS proxy and certificate configuration.
function(smoothmail_download_asset url algorithm expected destination)
    if(NOT url MATCHES "^https://[^ \r\n]+$")
        message(FATAL_ERROR "Asset downloads require HTTPS.")
    endif()
    if(algorithm STREQUAL "SHA256")
        set(length 64)
    elseif(algorithm STREQUAL "SHA512")
        set(length 128)
    else()
        message(FATAL_ERROR "Unsupported asset digest.")
    endif()
    string(LENGTH "${expected}" actual_length)
    if(NOT actual_length EQUAL length OR NOT expected MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "Invalid asset digest.")
    endif()
    string(TOLOWER "${expected}" expected)
    get_filename_component(parent "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(LOCK "${destination}.lock" GUARD FUNCTION TIMEOUT 300)
    if(EXISTS "${destination}" OR IS_SYMLINK "${destination}")
        if(IS_DIRECTORY "${destination}" OR IS_SYMLINK "${destination}")
            message(FATAL_ERROR "Unsafe asset cache entry.")
        endif()
        file(${algorithm} "${destination}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Cached asset checksum mismatch; refusing to overwrite.")
        endif()
        return()
    endif()
    # Canonical mirrors avoid environment-dependent mirror selection.
    string(REGEX REPLACE "^https://ftpmirror\\.gnu\\.org/gnu/" "https://ftp.gnu.org/gnu/" url "${url}")
    string(REGEX REPLACE "^https://mirror\\.msys2\\.org/" "https://repo.msys2.org/" url "${url}")
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(partial "${destination}.${nonce}.part")
    file(DOWNLOAD "${url}" "${partial}" TLS_VERIFY ON TLS_VERSION 1.2
        TIMEOUT 600 INACTIVITY_TIMEOUT 60 STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
        file(REMOVE "${partial}")
        # Do not print URLs, proxy diagnostics or potentially private headers.
        message(FATAL_ERROR "HTTPS asset download failed (CMake status ${code}).")
    endif()
    file(${algorithm} "${partial}" actual)
    if(NOT actual STREQUAL expected)
        file(REMOVE "${partial}")
        message(FATAL_ERROR "Downloaded asset checksum mismatch.")
    endif()
    file(RENAME "${partial}" "${destination}" NO_REPLACE RESULT result)
    if(NOT result STREQUAL "0")
        file(REMOVE "${partial}")
        message(FATAL_ERROR "Could not publish verified asset without replacement.")
    endif()
endfunction()
