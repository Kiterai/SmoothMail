include_guard(GLOBAL)

function(smoothmail_prepare_sasl_source archive workspace output)
    find_package(Git REQUIRED)
    set(patch "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../patches/cyrus-sasl/2.1.28-explicit-runtime-paths.patch")
    file(SHA256 "${patch}" patch_hash)
    string(SUBSTRING "${patch_hash}" 0 16 key)
    set(work "${workspace}/cyrus-sasl-explicit-${key}")
    set(source "${work}/cyrus-sasl-2.1.28")
    set(receipt "${work}/source-config.sha256")
    if(IS_SYMLINK "${work}" OR IS_SYMLINK "${source}")
        message(FATAL_ERROR "Linked SASL work directories are not supported.")
    endif()
    if(NOT EXISTS "${source}")
        file(MAKE_DIRECTORY "${work}")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${work}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GIT_CEILING_DIRECTORIES=${work}"
            "${GIT_EXECUTABLE}" -C "${source}" apply --check "${patch}"
            COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GIT_CEILING_DIRECTORIES=${work}"
            "${GIT_EXECUTABLE}" -C "${source}" apply "${patch}"
            COMMAND_ERROR_IS_FATAL ANY)
        file(COPY_FILE "${source}/win32/include/md5global.h" "${source}/include/md5global.h")
        file(SHA256 "${source}/win32/include/config.h" config_hash)
        file(WRITE "${receipt}" "${patch_hash}\n${config_hash}\n")
    endif()
    if(NOT EXISTS "${receipt}" OR IS_SYMLINK "${source}" OR IS_SYMLINK "${receipt}")
        message(FATAL_ERROR "SASL source receipt missing or linked; use a new dependency root.")
    endif()
    file(SHA256 "${source}/win32/include/config.h" config_hash)
    file(READ "${receipt}" recorded)
    if(NOT recorded STREQUAL "${patch_hash}\n${config_hash}\n")
        message(FATAL_ERROR "SASL source configuration changed; nothing was overwritten.")
    endif()
    set("${output}" "${source}" PARENT_SCOPE)
endfunction()
