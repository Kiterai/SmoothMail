include_guard(GLOBAL)

function(smoothmail_write_modified_receipt directory artifact commit patch)
    if(CMAKE_BUILD_TYPE STREQUAL Debug)
        set(qtcore "${Qt6_ROOT}/bin/Qt6Cored.dll")
    else()
        set(qtcore "${Qt6_ROOT}/bin/Qt6Core.dll")
    endif()
    file(SHA256 "${artifact}" artifact_hash)
    file(SHA256 "${patch}" patch_hash)
    file(SHA256 "${qtcore}" qt_hash)
    file(WRITE "${directory}/smoothmail-build.json"
        "{\"commit\":\"${commit}\",\"patch_sha256\":\"${patch_hash}\",\"artifact_sha256\":\"${artifact_hash}\",\"qtcore_sha256\":\"${qt_hash}\",\"configuration\":\"${CMAKE_BUILD_TYPE}\"}\n")
endfunction()

function(smoothmail_validate_modified_receipt receipt artifact qtcore commit patch configuration)
    foreach(path IN ITEMS "${receipt}" "${artifact}" "${qtcore}" "${patch}")
        if(NOT EXISTS "${path}")
            message(FATAL_ERROR "Missing modified dependency receipt/artifact: ${path}. Rebuild the local dependencies.")
        endif()
    endforeach()
    # Parse as JSON data only. Never execute receipts from an install prefix.
    file(READ "${receipt}" content)
    file(SHA256 "${artifact}" artifact_hash)
    file(SHA256 "${patch}" patch_hash)
    file(SHA256 "${qtcore}" qt_hash)
    set(fields commit patch_sha256 artifact_sha256 qtcore_sha256 configuration)
    set(expected_values "${commit}" "${patch_hash}" "${artifact_hash}" "${qt_hash}" "${configuration}")
    foreach(index RANGE 0 4)
        list(GET fields ${index} field)
        list(GET expected_values ${index} expected)
        string(JSON actual ERROR_VARIABLE error GET "${content}" "${field}")
        if(NOT error STREQUAL "NOTFOUND" OR NOT actual STREQUAL expected)
            message(FATAL_ERROR "Modified dependency verification failed (${field}): ${receipt}. Rebuild with the pinned patch, matching Qt SDK and build configuration.")
        endif()
    endforeach()
endfunction()
