cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/DependencyBuild.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PreparePatchedSource.cmake")
smoothmail_fetch_dependency(winflexbison pristine)
string(JSON commit GET "${manifest}" winflexbison commit)
get_filename_component(patch "${CMAKE_CURRENT_LIST_DIR}/../patches/winflexbison/out-of-source-output.patch" ABSOLUTE)
smoothmail_prepare_patched_source(winflexbison "${pristine}" "${commit}" "${patch}" "${DEPENDENCY_ROOT}/patched-src" source)
file(SHA256 "${patch}" patch_hash)
string(SUBSTRING "${patch_hash}" 0 16 patch_key)
set(binary "${DEPENDENCY_ROOT}/build/tools/winflexbison-${patch_key}")
smoothmail_dependency_command("${CMAKE_COMMAND}" -S "${source}" -B "${binary}" -G Ninja
    "-DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}" -DCMAKE_BUILD_TYPE=Release
    "-DCMAKE_INSTALL_PREFIX=${DEPENDENCY_ROOT}/tools/winflexbison")
smoothmail_dependency_command("${CMAKE_COMMAND}" --build "${binary}" --parallel 4)
smoothmail_dependency_command("${CMAKE_COMMAND}" --install "${binary}")
