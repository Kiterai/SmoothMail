# Introspection-only: no compiler, Qt SDK, dependency receipt or application build.
function(smoothmail_target_defaults target)
endfunction()
set(SMOOTHMAIL_BUILD_MIME ON)
include("${CMAKE_CURRENT_LIST_DIR}/ApplicationTargets.cmake")
get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
set(manifest "{}")
foreach(target IN LISTS targets)
    get_target_property(kind "${target}" SMOOTHMAIL_DOCUMENTED_KIND)
    get_target_property(sources "${target}" SMOOTHMAIL_DOCUMENTED_SOURCES)
    set(files "[]")
    set(index 0)
    foreach(source IN LISTS sources)
        string(JSON files SET "${files}" ${index} "\"${source}\"")
        math(EXPR index "${index}+1")
    endforeach()
    string(JSON manifest SET "${manifest}" "${target}" "{\"kind\":\"${kind}\",\"sources\":${files}}")
endforeach()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/documentation-targets.json" "${manifest}\n")
