cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/DependencyBuild.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PreparePatchedSource.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ModifiedDependencyReceipt.cmake")
if(NOT WIN32)
    message(FATAL_ERROR "The runtime-path KCrash bootstrap is for Windows only.")
endif()
smoothmail_fetch_dependency(kcrash pristine)
string(JSON commit GET "${manifest}" kcrash commit)
get_filename_component(patch "${CMAKE_CURRENT_LIST_DIR}/../patches/kcrash/6.31.0-windows-runtime-paths.patch" ABSOLUTE)
smoothmail_prepare_patched_source(kcrash "${pristine}" "${commit}" "${patch}" "${DEPENDENCY_ROOT}/patched-src" source)
file(SHA256 "${patch}" patch_hash)
string(SUBSTRING "${patch_hash}" 0 16 patch_key)
set(binary "${DEPENDENCY_ROOT}/build/${CMAKE_BUILD_TYPE}/kcrash-runtime-${patch_key}")
smoothmail_build_dependency_source(kcrash "${source}" "${binary}")
set(notices "${prefix}/share/licenses/kcrash")
file(MAKE_DIRECTORY "${notices}")
file(COPY "${pristine}/LICENSES" "${patch}" "${CMAKE_CURRENT_LIST_DIR}/../patches/kcrash/README.md"
    DESTINATION "${notices}")
smoothmail_write_modified_receipt("${notices}" "${prefix}/bin/KF6Crash.dll" "${commit}" "${patch}")
