cmake_minimum_required(VERSION 3.30)
if(NOT WIN32)
    message(FATAL_ERROR "Windows/MSVC x64 developer environment required.")
endif()
foreach(required IN ITEMS Qt6_ROOT LEGAL_DIR OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Specify ${required}.")
    endif()
    get_filename_component(${required} "${${required}}" ABSOLUTE)
endforeach()
if(NOT OUTPUT MATCHES "\\.[zZ][iI][pP]$")
    message(FATAL_ERROR "Distribution output must be a ZIP.")
endif()
if(EXISTS "${OUTPUT}" OR IS_SYMLINK "${OUTPUT}")
    message(FATAL_ERROR "Output already exists; it will not be overwritten.")
endif()
if(NOT DEFINED CRT_BIN)
    file(TO_CMAKE_PATH "$ENV{VCToolsRedistDir}" redist)
    file(GLOB crt_candidates LIST_DIRECTORIES TRUE "${redist}/x64/Microsoft.VC*.CRT")
    list(LENGTH crt_candidates count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Cannot uniquely locate MSVC Release CRT; specify -DCRT_BIN.")
    endif()
    list(GET crt_candidates 0 CRT_BIN)
endif()
if(NOT EXISTS "${CRT_BIN}/vcruntime140.dll")
    message(FATAL_ERROR "Missing redistributable Release CRT.")
endif()
set(CMAKE_BUILD_TYPE Release)
include("${CMAKE_CURRENT_LIST_DIR}/DependencyBuild.cmake")
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(helper_build "${DEPENDENCY_ROOT}/build/tools/package")
smoothmail_dependency_command("${CMAKE_COMMAND}" -S "${repository}/tools/windows-package"
    -B "${helper_build}" -G Ninja "-DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}"
    "-DQt6_ROOT=${Qt6_ROOT}" -DCMAKE_BUILD_TYPE=Release)
smoothmail_dependency_command("${CMAKE_COMMAND}" --build "${helper_build}" --parallel 4)
set(ENV{PATH} "${Qt6_ROOT}/bin;$ENV{PATH}")
set(helper "${helper_build}/smoothmail_package.exe")
# Fail before expensive dependency/application builds if notices are incomplete.
smoothmail_dependency_command("${helper}" --check-legal "${LEGAL_DIR}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(job "${repository}/build/package-windows/release-${nonce}")
if(EXISTS "${job}")
    message(FATAL_ERROR "Package job directory already exists.")
endif()
set(APPLICATION_BUILD "${job}/build")
set(BUILD_TESTING OFF)
set(SMOOTHMAIL_DISTRIBUTION ON)
include("${CMAKE_CURRENT_LIST_DIR}/BuildWindows.cmake")
set(stage "${job}/runtime")
smoothmail_dependency_command("${CMAKE_COMMAND}"
    "-DAPP=${APPLICATION_BUILD}/smoothmail.exe" "-DQT_BIN=${Qt6_ROOT}/bin"
    "-DDEPENDENCY_BIN=${prefix}/bin" "-DNATIVE_BIN=${SMOOTHMAIL_NATIVE_PREFIX}/bin"
    "-DSASL_DIR=${prefix}/bin/sasl2" "-DCRT_BIN=${CRT_BIN}"
    "-DDESTINATION=${stage}" -DCONFIGURATION=Release
    -P "${CMAKE_CURRENT_LIST_DIR}/StageWindowsRelease.cmake")
smoothmail_dependency_command("${helper}" --package-with-policy "${stage}" "${LEGAL_DIR}" "${repository}" "${OUTPUT}"
    "${CMAKE_CURRENT_LIST_DIR}/runtime-path-policy.json"
    "${repository}" "${DEPENDENCY_ROOT}" "${job}" "${Qt6_ROOT}" "${CRT_BIN}" "${LEGAL_DIR}"
    "$ENV{USERPROFILE}" "$ENV{TEMP}" "$ENV{USERNAME}" "$ENV{COMPUTERNAME}")
message(STATUS "Release ZIP published; privacy and coverage checks passed.")
