cmake_minimum_required(VERSION 3.30)
# Assemble review text and previously collected originals. Never approve legal
# input, build a product, fetch unpinned licenses, or change existing evidence.
include("${CMAKE_CURRENT_LIST_DIR}/LicenseTemplates.cmake")
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED ENV_FILE)
    set(ENV_FILE "${repository}/.env")
endif()
get_filename_component(ENV_FILE "${ENV_FILE}" ABSOLUTE)
smoothmail_read_license_env("${ENV_FILE}")
if(NOT DEFINED EDITION)
    set(EDITION windows-x64)
endif()
if(NOT EDITION STREQUAL windows-x64)
    message(FATAL_ERROR "No reviewed component profile for the requested license edition.")
endif()
set(common_root "${repository}/licenses/common")
set(edition_root "${repository}/licenses/editions/${EDITION}")
foreach(required IN ITEMS EVIDENCE SOURCE_REVIEW OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Specify ${required}.")
    endif()
    get_filename_component(${required} "${${required}}" ABSOLUTE)
endforeach()
if(EXISTS "${OUTPUT}" OR IS_SYMLINK "${OUTPUT}")
    message(FATAL_ERROR "Choose a new legal draft output; nothing is overwritten.")
endif()
if(NOT EXISTS "${EVIDENCE}/manifest.review.json"
        OR NOT EXISTS "${EVIDENCE}/runtime-components-sha256.txt"
        OR NOT EXISTS "${SOURCE_REVIEW}/source-manifest.review.json")
    message(FATAL_ERROR "Collected legal/source evidence is required.")
endif()
file(READ "${EVIDENCE}/manifest.review.json" manifest)
string(JSON review_only GET "${manifest}" review_only)
if(NOT review_only OR EXISTS "${EVIDENCE}/manifest.json")
    message(FATAL_ERROR "Expected unapproved review evidence.")
endif()
file(READ "${SOURCE_REVIEW}/source-manifest.review.json" sources)
string(JSON source_count LENGTH "${sources}" archives)
string(JSON count LENGTH "${manifest}" components)
if(NOT count EQUAL 19 OR NOT source_count EQUAL 23)
    message(FATAL_ERROR "Component/source profile changed; review the draft first.")
endif()

function(regular_file base relative)
    if(relative STREQUAL "" OR relative MATCHES "(^/|\\\\|:|(^|/)\\.\\.(/|$)|[;\r\n])")
        message(FATAL_ERROR "Unsafe evidence reference.")
    endif()
    file(REAL_PATH "${base}" real_base)
    file(REAL_PATH "${base}/${relative}" real_file)
    cmake_path(IS_PREFIX real_base "${real_file}" NORMALIZE contained)
    if(NOT contained OR NOT EXISTS "${real_file}" OR IS_DIRECTORY "${real_file}"
            OR IS_SYMLINK "${base}/${relative}")
        message(FATAL_ERROR "Missing or linked evidence reference.")
    endif()
endfunction()

math(EXPR source_last "${source_count}-1")
set(SOURCE_ROWS "")
foreach(i RANGE 0 ${source_last})
    foreach(field IN ITEMS component file sha256)
        string(JSON ${field} GET "${sources}" archives ${i} ${field})
    endforeach()
    regular_file("${SOURCE_REVIEW}" "${file}")
    file(SHA256 "${SOURCE_REVIEW}/${file}" actual)
    if(NOT actual STREQUAL sha256)
        message(FATAL_ERROR "Source archive differs from the supplied inventory.")
    endif()
    string(APPEND SOURCE_ROWS "| ${component} | `${file}` | `${sha256}` |\n")
endforeach()

set(components "")
set(components_ja "")
set(assigned)
math(EXPR last "${count}-1")
# Validate all referenced evidence before creating output.
foreach(i RANGE 0 ${last})
    string(JSON id GET "${manifest}" components ${i} name)
    if(NOT id MATCHES "^[A-Za-z0-9-]+$")
        message(FATAL_ERROR "Unsafe component identifier.")
    endif()
    string(JSON notice GET "${manifest}" components ${i} source_notice)
    regular_file("${EVIDENCE}" "${notice}")
    string(JSON n LENGTH "${manifest}" components ${i} license_files)
    if(n GREATER 0)
        math(EXPR end "${n}-1")
        foreach(j RANGE 0 ${end})
            string(JSON name GET "${manifest}" components ${i} license_files ${j})
            regular_file("${EVIDENCE}" "${name}")
        endforeach()
    elseif(NOT id STREQUAL msvc-crt)
        message(FATAL_ERROR "Missing license originals.")
    endif()
endforeach()

file(MAKE_DIRECTORY "${OUTPUT}/evidence" "${OUTPUT}/notices")
file(MAKE_DIRECTORY "${OUTPUT}/originals")
file(COPY "${EVIDENCE}/licenses/" DESTINATION "${OUTPUT}/originals")
# Development history and previous draft prose are not distribution notices.
foreach(name IN ITEMS manifest.review.json runtime-components-sha256.txt)
    file(COPY_FILE "${EVIDENCE}/${name}" "${OUTPUT}/evidence/${name}")
endforeach()
file(COPY_FILE "${SOURCE_REVIEW}/source-manifest.review.json" "${OUTPUT}/evidence/source-manifest.review.json")
foreach(name IN ITEMS README NOTICE SOURCE-AND-REPLACEMENT SOURCES)
    foreach(suffix IN ITEMS .md .ja.md)
        smoothmail_render_license_template("${common_root}/${name}${suffix}" "${OUTPUT}/${name}${suffix}")
    endforeach()
endforeach()
foreach(name IN ITEMS THIRD-PARTY CHANGES MICROSOFT-RUNTIME)
    foreach(suffix IN ITEMS .md .ja.md)
        smoothmail_render_license_template("${edition_root}/${name}${suffix}" "${OUTPUT}/${name}${suffix}")
    endforeach()
endforeach()
foreach(i RANGE 0 ${last})
    foreach(field IN ITEMS name version)
        string(JSON ${field} GET "${manifest}" components ${i} ${field})
    endforeach()
    set(id "${name}")
    # Collected original texts move beneath licenses/originals in the ZIP.
    string(JSON license_count LENGTH "${manifest}" components ${i} license_files)
    if(license_count GREATER 0)
        math(EXPR license_last "${license_count}-1")
        foreach(j RANGE 0 ${license_last})
            string(JSON original GET "${manifest}" components ${i} license_files ${j})
            if(NOT original MATCHES "^licenses/")
                message(FATAL_ERROR "Unexpected original license location in evidence.")
            endif()
            string(REGEX REPLACE "^licenses/" "originals/" original "${original}")
            string(JSON manifest SET "${manifest}" components ${i} license_files ${j} "\"${original}\"")
        endforeach()
    endif()
    string(JSON n LENGTH "${manifest}" components ${i} binaries)
    math(EXPR end "${n}-1")
    set(binary_text "")
    foreach(j RANGE 0 ${end})
        string(JSON binary GET "${manifest}" components ${i} binaries ${j})
        if(binary IN_LIST assigned)
            message(FATAL_ERROR "Duplicate runtime assignment.")
        endif()
        list(APPEND assigned "${binary}")
        string(APPEND binary_text "- `${binary}`\n")
    endforeach()
    set(source_id "${id}")
    if(id STREQUAL gettext-libintl)
        set(source_id gettext)
    endif()
    set(source_text "")
    set(source_text_ja "")
    foreach(j RANGE 0 ${source_last})
        string(JSON component GET "${sources}" archives ${j} component)
        if(component STREQUAL source_id)
            string(JSON archive GET "${sources}" archives ${j} file)
            string(APPEND source_text "Source archive: `${archive}`. SHA256: [source list](../SOURCES.md).\n")
            string(APPEND source_text_ja "ソースアーカイブ：`${archive}`。SHA256：[ソース一覧](../SOURCES.ja.md)。\n")
        endif()
    endforeach()
    if(id STREQUAL msvc-crt)
        set(source_text "Microsoft binaries are subject to the [Microsoft runtime conditions](../MICROSOFT-RUNTIME.md), not the open-source licenses of the other components.\n")
        set(source_text_ja "Microsoftバイナリには[Microsoftランタイム適用条件](../MICROSOFT-RUNTIME.ja.md)を適用し、他のコンポーネントのオープンソースライセンスは適用しない。\n")
        string(JSON manifest SET "${manifest}" components ${i} license_files "[\"MICROSOFT-RUNTIME.md\",\"MICROSOFT-RUNTIME.ja.md\"]")
    elseif(source_text STREQUAL "")
        message(FATAL_ERROR "Missing corresponding source component.")
    endif()
    set(license_text "")
    string(JSON n LENGTH "${manifest}" components ${i} license_files)
    math(EXPR end "${n}-1")
    foreach(j RANGE 0 ${end})
        string(JSON license GET "${manifest}" components ${i} license_files ${j})
        string(APPEND license_text "- [${license}](../${license})\n")
    endforeach()
    set(COMPONENT_NAME "${id}")
    set(COMPONENT_VERSION "${version}")
    set(BINARY_LIST "${binary_text}")
    set(LICENSE_LIST "${license_text}")
    set(SOURCE_DETAILS "${source_text}")
    smoothmail_render_license_template("${common_root}/COMPONENT-NOTICE.md" "${OUTPUT}/notices/${id}.md")
    set(SOURCE_DETAILS "${source_text_ja}")
    smoothmail_render_license_template("${common_root}/COMPONENT-NOTICE.ja.md" "${OUTPUT}/notices/${id}.ja.md")
    string(JSON manifest SET "${manifest}" components ${i} source_notice "\"notices/${id}.md\"")
    # Register translations explicitly; packaging/resource embedding follows
    # manifest entries, not the Markdown link graph.
    string(JSON n LENGTH "${manifest}" components ${i} license_files)
    string(JSON manifest SET "${manifest}" components ${i} license_files ${n} "\"notices/${id}.ja.md\"")
    if(id STREQUAL SmoothMail)
        foreach(common IN ITEMS README NOTICE SOURCE-AND-REPLACEMENT THIRD-PARTY CHANGES MICROSOFT-RUNTIME COMPONENTS SOURCES)
            foreach(suffix IN ITEMS .md .ja.md)
                string(JSON n LENGTH "${manifest}" components ${i} license_files)
                string(JSON manifest SET "${manifest}" components ${i} license_files ${n} "\"${common}${suffix}\"")
            endforeach()
        endforeach()
    endif()
    string(APPEND components "## ${id} ${version}\n\n${binary_text}\n[License and source notices](notices/${id}.md)\n\n")
    string(APPEND components_ja "## ${id} ${version}\n\n${binary_text}\n[ライセンス及びソース通知](notices/${id}.ja.md)\n\n")
endforeach()
list(LENGTH assigned files)
if(NOT files EQUAL 34)
    message(FATAL_ERROR "Runtime profile changed; do not use this draft unchanged.")
endif()
set(COMPONENT_ROWS "${components}")
smoothmail_render_license_template("${common_root}/COMPONENTS.md" "${OUTPUT}/COMPONENTS.md")
set(COMPONENT_ROWS "${components_ja}")
smoothmail_render_license_template("${common_root}/COMPONENTS.ja.md" "${OUTPUT}/COMPONENTS.ja.md")
if(DEFINED QT_SBOM_REVIEW AND NOT QT_SBOM_REVIEW STREQUAL "")
    file(READ "${QT_SBOM_REVIEW}" sbom)
    string(JSON sbom_review GET "${sbom}" review_only)
    string(JSON unresolved LENGTH "${sbom}" unresolved)
    if(NOT sbom_review OR NOT unresolved EQUAL 0)
        message(FATAL_ERROR "Expected a resolved review-only Qt SBOM closure.")
    endif()
    # Preserve audit data separately, without exposing the build review as
    # recipient-facing license prose. Original attributions remain in licenses/.
    file(COPY_FILE "${QT_SBOM_REVIEW}" "${OUTPUT}/evidence/qt-sbom.review.json")
endif()
file(WRITE "${OUTPUT}/manifest.review.json" "${manifest}\n")
message(STATUS "Legal draft assembled: ${files} files / ${count} components; originals retained; no manifest.json or approval.")
