{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Self-contained Windows Debug",
      "generator": "NMake Makefiles",
      "binaryDir": "${sourceDir}/build/dbg",
      "cacheVariables": {
        "SMOOTHMAIL_WORKFLOW": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Self-contained Windows Release and distribution",
      "generator": "NMake Makefiles",
      "binaryDir": "${sourceDir}/build/rel",
      "cacheVariables": {
        "SMOOTHMAIL_WORKFLOW": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "dev",
      "displayName": "Developer-supplied Qt SDK",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/build/deps/build/tools/ninja-79feac0f3e3bc9da9effc586cd5fea41e7550051/ninja.exe",
        "GETTEXT_MSGFMT_EXECUTABLE": "${sourceDir}/build/deps/native/x64-windows/tools/gettext/bin/msgfmt.exe",
        "GETTEXT_MSGMERGE_EXECUTABLE": "${sourceDir}/build/deps/native/x64-windows/tools/gettext/bin/msgmerge.exe",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/deps/install/Debug",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "dev", "configurePreset": "dev" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    }
  ]
}
