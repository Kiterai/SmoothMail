digraph dependencies {
rankdir=LR;
graph [fontname="Arial"];
node [shape=box, fontname="Arial", style=filled];
edge [color="#64748b"];
"src" [label="src", fillcolor="#dbeafe"];
"src/app" [label="src/app", fillcolor="#dbeafe"];
"src/core" [label="src/core", fillcolor="#dbeafe"];
"src/mail" [label="src/mail", fillcolor="#dbeafe"];
"src/mime" [label="src/mime", fillcolor="#dbeafe"];
"src/oauth" [label="src/oauth", fillcolor="#dbeafe"];
"src/storage" [label="src/storage", fillcolor="#dbeafe"];
"src/ui" [label="src/ui", fillcolor="#dbeafe"];
"src" -> "src/app";
"src" -> "src/core";
"src" -> "src/ui";
"src/app" -> "src/core";
"src/app" -> "src/mail";
"src/app" -> "src/storage";
"src/app" -> "src/ui";
"src/mail" -> "src/core";
"src/mail" -> "src/mime";
"src/mail" -> "src/oauth";
"src/mail" -> "src/storage";
"src/mime" -> "src/core";
"src/storage" -> "src/core";
"src/storage" -> "src/mime";
"src/storage" -> "src/oauth";
"src/ui" -> "src/core";
"src/ui" -> "src/mime";
}
