cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/WindowsCrt.cmake")
if(NOT DEFINED CRT_BIN)
    file(TO_CMAKE_PATH "$ENV{VCToolsRedistDir}" redist)
    set(CRT_BIN "${redist}/x64/Microsoft.VC143.CRT")
endif()
smoothmail_validate_crt_directory("${CRT_BIN}")
smoothmail_prepare_crt_verifier(helper)
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
file(MAKE_DIRECTORY "${repository}/build/crt-verifier-tests")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
execute_process(COMMAND "${helper}" --self-test "${CRT_BIN}/vcruntime140.dll"
    "${repository}/build/crt-verifier-tests/${nonce}" RESULT_VARIABLE result)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "CRT binary/signature/version guards failed.")
endif()
