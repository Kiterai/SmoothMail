cmake_minimum_required(VERSION 3.30)
find_package(Git REQUIRED)
if(NOT EXISTS "${REVIEW}/source-manifest.review.json")
    message(FATAL_ERROR "Specify a source REVIEW.")
endif()
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${repository}/build/source-review-tests/${nonce}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Fixture already exists.")
endif()
file(MAKE_DIRECTORY "${root}")
file(READ "${REVIEW}/source-manifest.review.json" manifest)
string(JSON count LENGTH "${manifest}" archives)
string(JSON missing LENGTH "${manifest}" missing)
if(NOT count EQUAL 21 OR NOT missing EQUAL 0)
    message(FATAL_ERROR "Source review is incomplete.")
endif()
math(EXPR last "${count}-1")
foreach(i RANGE 0 ${last})
    string(JSON name GET "${manifest}" archives ${i} file)
    string(JSON expected GET "${manifest}" archives ${i} sha256)
    if(name MATCHES "[/\\\\:]|\\.\\.")
        message(FATAL_ERROR "Unsafe archive name.")
    endif()
    file(SHA256 "${REVIEW}/${name}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Source archive digest mismatch.")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${REVIEW}/${name}"
        OUTPUT_VARIABLE names COMMAND_ERROR_IS_FATAL ANY)
    if(names MATCHES "(^|\n)[/\\\\]|(^|[/\\\\])\\.\\.([/\\\\]|\n)|(^|[/\\\\])\\.git([/\\\\]|\n)")
        message(FATAL_ERROR "Unsafe or developer metadata in source archive.")
    endif()
    file(ARCHIVE_EXTRACT INPUT "${REVIEW}/${name}" DESTINATION "${root}")
endforeach()
foreach(patch IN ITEMS
        kcodecs/6.31.0-safe-ctype.patch kmime/6.31.0-safe-ctype.patch
        kconfig/6.31.0-optional-check-update.patch kcrash/6.31.0-windows-runtime-paths.patch
        kio/6.31.0-smoothmail-portable-core.patch kimap/26.08.3-fix-sasl-continuation.patch
        ksmtp/26.08.3-reset-ehlo-capabilities.patch)
    string(REGEX REPLACE "/.*" "" component "${patch}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GIT_CEILING_DIRECTORIES=${root}"
        "${GIT_EXECUTABLE}" -C "${root}/${component}" apply --check
        "${root}/SmoothMail/patches/${patch}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
file(READ "${root}/SmoothMail/CMakeLists.txt" cmake)
file(READ "${root}/qtbase/LICENSES/LGPL-3.0-only.txt" lgpl)
if(NOT cmake MATCHES "LicenseResources.cmake" OR NOT lgpl MATCHES "GNU LESSER GENERAL PUBLIC LICENSE")
    message(FATAL_ERROR "Missing exported build or Qt license evidence.")
endif()
message(STATUS "21 source archives independently extracted and hashed; 7 active KDE patches apply.")
message(STATUS "Review extraction retained; full rebuild and source/binary attribution remain separate checks.")
