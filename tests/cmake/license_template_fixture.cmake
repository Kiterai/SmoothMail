cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/LicenseTemplates.cmake")
file(MAKE_DIRECTORY "${ROOT}")
set(config "SOFTWARE_NAME=\"Example Mail\"\nDISTRIBUTION_URL=https://example.invalid/downloads/v1\nBUILD_VERSION='1.2.3-test'\n")
if(CASE STREQUAL missing)
    set(config "SOFTWARE_NAME=Example Mail\n")
elseif(CASE STREQUAL empty)
    string(REPLACE "Example Mail" "" config "${config}")
elseif(CASE STREQUAL duplicate)
    string(APPEND config "SOFTWARE_NAME=Duplicate\n")
elseif(CASE STREQUAL unknown)
    string(APPEND config "UNRELATED_SECRET=not-to-be-printed\n")
elseif(CASE STREQUAL malformed)
    string(APPEND config "export OTHER=value\n")
elseif(CASE STREQUAL http)
    string(REPLACE "https://" "http://" config "${config}")
elseif(CASE STREQUAL credentials)
    string(REPLACE "example.invalid" "user:secret@example.invalid" config "${config}")
elseif(CASE STREQUAL expansion)
    string(REPLACE "Example Mail" "\${ENV_SECRET}" config "${config}")
elseif(CASE STREQUAL semicolon)
    string(REPLACE "Example Mail" "Example;Mail" config "${config}")
elseif(CASE STREQUAL markdown)
    string(REPLACE "Example Mail" "[Injected](target)" config "${config}")
elseif(CASE STREQUAL multiline)
    string(REPLACE "Example Mail" "Example\nMail" config "${config}")
endif()
file(WRITE "${ROOT}/.env" "${config}")
smoothmail_read_license_env("${ROOT}/.env")
set(EDITION windows-x64)
set(template "@SOFTWARE_NAME@ | @DISTRIBUTION_URL@ | @BUILD_VERSION@ | @EDITION@\n")
if(CASE STREQUAL unknown-template)
    string(APPEND template "@UNRELATED_SECRET@\n")
elseif(CASE STREQUAL unset-template)
    string(APPEND template "@COMPONENT_NAME@\n")
endif()
file(WRITE "${ROOT}/template.md" "${template}")
smoothmail_render_license_template("${ROOT}/template.md" "${ROOT}/generated.md")
file(READ "${ROOT}/generated.md" actual)
if(NOT actual STREQUAL "Example Mail | https://example.invalid/downloads/v1 | 1.2.3-test | windows-x64\n")
    message(FATAL_ERROR "License template did not use the explicit environment values.")
endif()
