cmake_minimum_required(VERSION 3.30)
if(EXISTS "${LEGAL}/manifest.json")
    set(manifest_path "${LEGAL}/manifest.json")
else()
    set(manifest_path "${LEGAL}/manifest.review.json")
endif()
file(READ "${manifest_path}" manifest)
file(READ "${RESOURCES}/catalog.json" catalog)
string(JSON count LENGTH "${manifest}" components)
math(EXPR last "${count}-1")
set(paths)
foreach(i RANGE 0 ${last})
    string(JSON notice GET "${manifest}" components ${i} source_notice)
    list(APPEND paths "${notice}")
    string(JSON n LENGTH "${manifest}" components ${i} license_files)
    if(n GREATER 0)
        math(EXPR end "${n}-1")
        foreach(j RANGE 0 ${end})
            string(JSON path GET "${manifest}" components ${i} license_files ${j})
            list(APPEND paths "${path}")
        endforeach()
    endif()
endforeach()
list(REMOVE_DUPLICATES paths)
string(JSON count LENGTH "${catalog}")
math(EXPR last "${count}-1")
set(entries)
foreach(i RANGE 0 ${last})
    string(JSON path GET "${catalog}" ${i} file)
    if(path IN_LIST entries)
        message(FATAL_ERROR "Duplicate embedded license document.")
    endif()
    list(APPEND entries "${path}")
endforeach()
foreach(path IN LISTS paths)
    if(NOT "documents/${path}" IN_LIST entries)
        message(FATAL_ERROR "License catalogue omitted a referenced document.")
    endif()
    file(SHA256 "${LEGAL}/${path}" expected)
    file(SHA256 "${RESOURCES}/documents/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "License resource changed original document bytes.")
    endif()
endforeach()
list(LENGTH paths count)
message(STATUS "${count} embedded documents preserve paths, extensions and original bytes.")
