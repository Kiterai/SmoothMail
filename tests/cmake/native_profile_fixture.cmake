cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/NativeDependencySettings.cmake")
string(REPEAT "a" 64 expected)
file(MAKE_DIRECTORY "${ROOT}")
if(CASE STREQUAL "changed")
    string(REPEAT "b" 64 old)
    file(WRITE "${ROOT}/smoothmail-profile.sha256" "${old}\n")
elseif(CASE STREQUAL "unknown")
    file(WRITE "${ROOT}/user-work.txt" "keep")
elseif(CASE STREQUAL "matching")
    file(WRITE "${ROOT}/smoothmail-profile.sha256" "${expected}\n")
endif()
smoothmail_prepare_native_profile("${ROOT}" "${expected}")
file(READ "${ROOT}/smoothmail-profile.sha256" actual)
string(STRIP "${actual}" actual)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Native profile receipt mismatch.")
endif()
