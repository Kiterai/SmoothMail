cmake_minimum_required(VERSION 3.25)
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT CHILD)
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    foreach(case IN ITEMS example configured duplicate unknown)
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DCHILD=${case}"
            "-DROOT=${repository}/build/oauth-defaults-tests/${nonce}/${case}"
            -P "${CMAKE_CURRENT_LIST_FILE}"
            RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(case STREQUAL example OR case STREQUAL configured)
            if(NOT result STREQUAL "0")
                message(FATAL_ERROR "OAuth default generation failed.")
            endif()
        elseif(result STREQUAL "0")
            message(FATAL_ERROR "Invalid OAuth default configuration accepted.")
        endif()
        if("${out}${err}" MATCHES "never-print-this")
            message(FATAL_ERROR "OAuth configuration disclosed in diagnostics.")
        endif()
    endforeach()
    return()
endif()
set(PROJECT_SOURCE_DIR "${ROOT}/source")
set(PROJECT_BINARY_DIR "${ROOT}/binary")
file(MAKE_DIRECTORY "${PROJECT_SOURCE_DIR}")
set(metadata "SOFTWARE_NAME=Fixture\nDISTRIBUTION_URL=https://example.invalid\nBUILD_VERSION=1\n")
file(WRITE "${PROJECT_SOURCE_DIR}/.env.example" "${metadata}SMOOTHMAIL_GOOGLE_CLIENT_ID=\nSMOOTHMAIL_GOOGLE_CLIENT_SECRET=\nSMOOTHMAIL_MICROSOFT_CLIENT_ID=\n")
if(NOT CHILD STREQUAL example)
    file(WRITE "${PROJECT_SOURCE_DIR}/.env" "${metadata}SMOOTHMAIL_GOOGLE_CLIENT_ID='fixture-google'\nSMOOTHMAIL_GOOGLE_CLIENT_SECRET=\"never-print-this\"\nSMOOTHMAIL_MICROSOFT_CLIENT_ID=fixture-microsoft\n")
endif()
if(CHILD STREQUAL duplicate)
    file(APPEND "${PROJECT_SOURCE_DIR}/.env" "SMOOTHMAIL_GOOGLE_CLIENT_ID=never-print-this\n")
elseif(CHILD STREQUAL unknown)
    file(APPEND "${PROJECT_SOURCE_DIR}/.env" "UNKNOWN=never-print-this\n")
endif()
set(ENV{SMOOTHMAIL_GOOGLE_CLIENT_ID} "ignored-process-value")
include("${repository}/cmake/OAuthDefaults.cmake")
file(READ "${PROJECT_BINARY_DIR}/generated/oauthdefaults.h" generated)
if(CHILD STREQUAL example)
    if(NOT generated MATCHES "fromHex\\(\"\"\\)")
        message(FATAL_ERROR "Empty example defaults were not preserved.")
    endif()
else()
    foreach(value IN ITEMS fixture-google never-print-this fixture-microsoft)
        string(HEX "${value}" expected)
        string(FIND "${generated}" "${expected}" position)
        if(position LESS 0)
            message(FATAL_ERROR "Configured OAuth default was not embedded correctly.")
        endif()
    endforeach()
endif()
string(HEX "ignored-process-value" forbidden)
if(generated MATCHES "${forbidden}")
    message(FATAL_ERROR "Process environment overrode build defaults.")
endif()
