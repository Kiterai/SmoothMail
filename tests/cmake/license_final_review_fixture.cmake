cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/LicenseFinalReview.cmake")
file(MAKE_DIRECTORY "${ROOT}/evidence" "${ROOT}/stage")
file(WRITE "${ROOT}/stage/library.dll" "synthetic")
file(SHA256 "${ROOT}/stage/library.dll" hash)
set(name library.dll)
set(owner fixture)
if(CASE STREQUAL changed)
    file(APPEND "${ROOT}/stage/library.dll" "changed")
elseif(CASE STREQUAL missing)
    file(REMOVE "${ROOT}/stage/library.dll")
elseif(CASE STREQUAL extra)
    file(WRITE "${ROOT}/stage/extra.dll" "extra")
elseif(CASE STREQUAL assignment)
    set(owner other)
elseif(CASE STREQUAL traversal)
    set(name ../library.dll)
endif()
set(inventory "SHA256  runtime-relative-file  component\n${hash}  ${name}  ${owner}\n")
if(CASE STREQUAL duplicate)
    string(APPEND inventory "${hash}  ${name}  ${owner}\n")
endif()
file(WRITE "${ROOT}/evidence/runtime-components-sha256.txt" "${inventory}")
set(manifest "{\"components\":[{\"name\":\"fixture\",\"binaries\":[\"library.dll\"]}]}")
smoothmail_check_license_runtime("${ROOT}/evidence" "${ROOT}/stage" "${manifest}" unused version records)
