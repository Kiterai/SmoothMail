cmake_minimum_required(VERSION 3.30)
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${repository}/cmake/SourceArchives.cmake")
file(READ "${repository}/cmake/dependencies.json" dependencies)
string(JSON dependency_count LENGTH "${dependencies}")
math(EXPR last "${dependency_count}-1")
foreach(i RANGE 0 ${last})
    string(JSON id MEMBER "${dependencies}" ${i})
    string(JSON commit GET "${dependencies}" "${id}" commit)
    smoothmail_archive_pin("${id}" "${commit}" archive_hash tree_hash)
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${repository}/build/source-archive-guards/${nonce}")
set(cases reuse bad-archive missing-archive revision changed-tree extra-file removed-file git-metadata bad-patch changed-patched extra-patched unknown)
foreach(case IN LISTS cases)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${case}" "-DROOT=${root}/${case}"
        -P "${CMAKE_CURRENT_LIST_DIR}/source_archive_fixture.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(case STREQUAL reuse AND NOT result STREQUAL "0")
        message(FATAL_ERROR "Pinned archive/patch reuse failed: ${out}\n${err}")
    elseif(NOT case STREQUAL reuse AND result STREQUAL "0")
        message(FATAL_ERROR "Unsafe archive source was accepted: ${case}")
    endif()
endforeach()
message(STATUS "12 archive import/tree/patch/reuse guards passed without Git metadata or network.")
