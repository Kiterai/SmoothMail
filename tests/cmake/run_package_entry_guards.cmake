cmake_minimum_required(VERSION 3.30)
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${repository}/build/package-entry-tests/${nonce}")
file(MAKE_DIRECTORY "${root}")
file(WRITE "${root}/existing.zip" "user artifact")
file(MAKE_DIRECTORY "${root}/legal" "${root}/missing-manifest"
    "${root}/directory-manifest/manifest.json" "${root}/empty-manifest")
file(WRITE "${root}/legal/manifest.json" "{}")
file(WRITE "${root}/empty-manifest/manifest.json" "")
file(WRITE "${root}/not-a-directory" "not a directory")
set(cases existing extension crt missing-legal missing-manifest directory-manifest empty-manifest file-legal)
foreach(case IN LISTS cases)
    set(output "${root}/${case}.zip")
    set(legal "${root}/legal")
    set(expected "LEGAL_DIR must contain")
    if(case STREQUAL extension)
        set(output "${root}/not-a-zip.txt")
        set(expected "Distribution output must be a ZIP")
    elseif(case STREQUAL existing)
        set(expected "Output already exists")
    elseif(case STREQUAL crt)
        set(expected "CRT_BIN must")
    elseif(case STREQUAL file-legal)
        set(legal "${root}/not-a-directory")
    else()
        set(legal "${root}/${case}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DQt6_ROOT=${root}/no-qt"
        "-DLEGAL_DIR=${legal}" "-DCRT_BIN=${root}/no-crt" "-DOUTPUT=${output}"
        "-DDEPENDENCY_ROOT=${root}/deps-${case}"
        -P "${repository}/cmake/PackageWindows.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(result STREQUAL "0" OR NOT "${out}\n${err}" MATCHES "${expected}")
        message(FATAL_ERROR "Package entry failed to reject ${case} at the expected preflight: ${out}\n${err}")
    endif()
    if(EXISTS "${root}/deps-${case}")
        message(FATAL_ERROR "Rejected package input started dependency acquisition.")
    endif()
    if(NOT case STREQUAL existing AND EXISTS "${output}")
        message(FATAL_ERROR "Failed preflight published output.")
    endif()
endforeach()
file(READ "${root}/existing.zip" contents)
if(NOT contents STREQUAL "user artifact")
    message(FATAL_ERROR "Package entry changed existing output.")
endif()
if(EXISTS "${root}/crt.zip" OR EXISTS "${root}/not-a-zip.txt")
    message(FATAL_ERROR "Failed preflight published output.")
endif()
list(LENGTH cases count)
message(STATUS "${count} package entry guards passed before dependency acquisition.")
