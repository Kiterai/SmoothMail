cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/QtLegalAttributions.cmake")
file(MAKE_DIRECTORY "${ROOT}/source/module")
foreach(name IN ITEMS LICENSE alternate.txt authors.txt)
    file(WRITE "${ROOT}/source/module/${name}" "Original ${name}\n")
endforeach()
file(WRITE "${ROOT}/source/shared.txt" "Shared original\n")
set(item "{\"LicenseFiles\":[\"LICENSE\",\"alternate.txt\"],\"CopyrightFile\":\"authors.txt\",\"LicenseFile\":\"../shared.txt\"}")
if(CASE STREQUAL escape)
    set(item "{\"LicenseFile\":\"../../outside.txt\"}")
    file(WRITE "${ROOT}/outside.txt" "Outside\n")
elseif(CASE STREQUAL missing)
    set(item "{\"LicenseFile\":\"missing.txt\"}")
elseif(CASE STREQUAL type)
    set(item "{\"LicenseFiles\":\"LICENSE\"}")
elseif(CASE STREQUAL entry-type)
    set(item "{\"LicenseFiles\":[123]}")
endif()
smoothmail_qt_attribution_files("${ROOT}/source" "${ROOT}/source/module/qt_attribution.json" "${item}" files)
list(LENGTH files count)
if(NOT count EQUAL 4)
    message(FATAL_ERROR "Qt attribution omitted a singular/plural license or copyright reference.")
endif()
