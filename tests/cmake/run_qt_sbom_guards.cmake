cmake_minimum_required(VERSION 3.30)
if(NOT EXISTS "${HELPER}")
    message(FATAL_ERROR "Specify the Qt SBOM helper.")
endif()
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${repository}/build/qt-sbom-guard-tests/${nonce}")
file(MAKE_DIRECTORY "${root}/sdk/sbom")
set(packages "[]")
set(index 0)
foreach(name IN ITEMS Core Gui Network Sql Widgets Xml QWindowsIntegrationPlugin QSQLiteDriverPlugin QSchannelBackendPlugin)
    string(JSON packages SET "${packages}" ${index}
        "{\"SPDXID\":\"SPDXRef-${name}\",\"name\":\"${name}\",\"licenseConcluded\":\"LGPL-3.0-only\"}")
    math(EXPR index "${index}+1")
endforeach()
string(JSON packages SET "${packages}" ${index} "{\"SPDXID\":\"SPDXRef-dep\",\"name\":\"included-static-dependency\",\"licenseConcluded\":\"MIT\"}")
math(EXPR index "${index}+1")
string(JSON packages SET "${packages}" ${index} "{\"SPDXID\":\"SPDXRef-tool\",\"name\":\"unshipped-build-tool\",\"licenseConcluded\":\"GPL-3.0-only\"}")
set(base "{\"packages\":${packages},\"relationships\":[
    {\"spdxElementId\":\"SPDXRef-Core\",\"relatedSpdxElement\":\"SPDXRef-dep\",\"relationshipType\":\"DEPENDS_ON\"},
    {\"spdxElementId\":\"SPDXRef-dep\",\"relatedSpdxElement\":\"SPDXRef-Core\",\"relationshipType\":\"DEPENDS_ON\"}]}")
file(WRITE "${root}/sdk/sbom/qtbase-6.12.0.spdx.json" "${base}")
file(WRITE "${root}/sdk/sbom/qtsvg-6.12.0.spdx.json"
    "{\"packages\":[{\"SPDXID\":\"SPDXRef-Svg\",\"name\":\"Svg\",\"licenseConcluded\":\"LGPL-3.0-only\"}],
      \"relationships\":[{\"spdxElementId\":\"SPDXRef-Svg\",\"relatedSpdxElement\":\"DocumentRef-qtbase:SPDXRef-Core\",\"relationshipType\":\"DEPENDS_ON\"}]}")
execute_process(COMMAND "${HELPER}" "${root}/sdk" "${root}/report.json" RESULT_VARIABLE result)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Synthetic dependency closure failed.")
endif()
file(READ "${root}/report.json" report)
string(JSON count LENGTH "${report}" packages)
if(NOT count EQUAL 11 OR report MATCHES "unshipped-build-tool")
    message(FATAL_ERROR "Unrelated build tool included or dependency omitted.")
endif()
file(SHA256 "${root}/report.json" before)
execute_process(COMMAND "${HELPER}" "${root}/sdk" "${root}/report.json" RESULT_VARIABLE result ERROR_QUIET)
file(SHA256 "${root}/report.json" after)
if(result STREQUAL "0" OR NOT before STREQUAL after)
    message(FATAL_ERROR "Existing report was overwritten.")
endif()
string(JSON base SET "${base}" relationships 2
    "{\"spdxElementId\":\"SPDXRef-Core\",\"relatedSpdxElement\":\"SPDXRef-missing\",\"relationshipType\":\"DEPENDS_ON\"}")
file(WRITE "${root}/sdk/sbom/qtbase-6.12.0.spdx.json" "${base}")
execute_process(COMMAND "${HELPER}" "${root}/sdk" "${root}/missing.json" RESULT_VARIABLE result)
if(result STREQUAL "0")
    message(FATAL_ERROR "Unresolved SDK dependency was accepted.")
endif()
file(REMOVE_RECURSE "${root}")
message(STATUS "Shipped-only closure, cycles, cross-document links, missing dependency and no-overwrite guards passed.")
