cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/WindowsCrt.cmake")
set(crt "${ROOT}/VC/Redist/MSVC/fixture/x64/Microsoft.VC143.CRT")
file(MAKE_DIRECTORY "${crt}")
foreach(name IN ITEMS msvcp140 vcruntime140 vcruntime140_threads msvcp140_2 concrt140 vccorlib140)
    file(WRITE "${crt}/${name}.dll" "Synthetic import graph only\n")
endforeach()
function(smoothmail_crt_imports binary output)
    get_filename_component(name "${binary}" NAME)
    if(name STREQUAL "app.exe")
        set(imports msvcp140.dll vcruntime140.dll kernel32.dll msvcp_win.dll)
        if(CASE STREQUAL debug)
            list(APPEND imports msvcp140d.dll)
        elseif(CASE STREQUAL unsupported)
            list(APPEND imports msvcp999.dll)
        endif()
    elseif(name STREQUAL "plugin.dll")
        set(imports msvcp140_2.dll)
    elseif(name STREQUAL "msvcp140.dll")
        set(imports vcruntime140_threads.dll vcruntime140.dll)
    elseif(name STREQUAL "vcruntime140_threads.dll")
        set(imports vcruntime140.dll)
    else()
        set(imports)
    endif()
    set(${output} "${imports}" PARENT_SCOPE)
endfunction()
if(CASE STREQUAL missing)
    file(REMOVE "${crt}/vcruntime140_threads.dll")
elseif(CASE STREQUAL wrong-directory)
    set(crt "${ROOT}")
endif()
smoothmail_collect_crt("${crt}" "${ROOT}/app.exe;${ROOT}/plugin.dll" files)
set(names)
foreach(file IN LISTS files)
    get_filename_component(name "${file}" NAME)
    list(APPEND names "${name}")
endforeach()
list(SORT names)
if(NOT names STREQUAL "msvcp140.dll;msvcp140_2.dll;vcruntime140.dll;vcruntime140_threads.dll")
    message(FATAL_ERROR "Required transitive/plugin CRT selection differs.")
endif()
