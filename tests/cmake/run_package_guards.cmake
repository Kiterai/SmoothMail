cmake_minimum_required(VERSION 3.30)
if(NOT EXISTS "${HELPER}")
    message(FATAL_ERROR "Specify HELPER (built smoothmail_package.exe).")
endif()
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${repository}/build/package-guard-tests/${nonce}")
file(MAKE_DIRECTORY "${root}")
execute_process(COMMAND "${HELPER}" --self-test "${root}/fixture.zip"
    RESULT_VARIABLE result)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Package self tests failed.")
endif()
# Independent libarchive reader validates the generated raw DEFLATE and CRCs.
file(ARCHIVE_EXTRACT INPUT "${root}/fixture.zip" DESTINATION "${root}/extracted")
file(STRINGS "${root}/extracted/SmoothMail/runtime-sha256.txt" inventory)
foreach(row IN LISTS inventory)
    string(SUBSTRING "${row}" 0 64 expected)
    string(SUBSTRING "${row}" 66 -1 name)
    file(SHA256 "${root}/extracted/SmoothMail/${name}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "ZIP inventory does not match extracted data.")
    endif()
endforeach()
if(NOT EXISTS "${root}/extracted/SmoothMail/runtime/empty.txt")
    message(FATAL_ERROR "ZIP lost empty file.")
endif()
if(NOT EXISTS "${root}/extracted/SmoothMail/licenses/manifest.json"
        OR NOT EXISTS "${root}/extracted/SmoothMail/licenses/license.txt"
        OR NOT EXISTS "${root}/extracted/SmoothMail/licenses/LICENSE"
        OR NOT EXISTS "${root}/extracted/SmoothMail/runtime/Smoothmail.exe"
        OR NOT EXISTS "${root}/extracted/SmoothMail/runtime/library.dll"
        OR EXISTS "${root}/extracted/SmoothMail/smoothmail.exe"
        OR EXISTS "${root}/extracted/SmoothMail/license"
        OR EXISTS "${root}/extracted/SmoothMail/legal")
    message(FATAL_ERROR "Distribution ZIP must separate licenses/ and runtime/.")
endif()
file(READ "${root}/extracted/SmoothMail/README.md" usage)
file(READ "${root}/extracted/SmoothMail/storage.md" storage)
if(NOT storage STREQUAL "# Fixture storage\n" OR EXISTS "${root}/extracted/SmoothMail/runtime/storage.md")
    message(FATAL_ERROR "Storage documentation must accompany README.md at the ZIP root.")
endif()
if(NOT usage STREQUAL "# Fixture usage\n")
    message(FATAL_ERROR "README.md differs from docs/usage.md.")
endif()
file(READ "${root}/extracted/SmoothMail/launch.cmd" launcher)
if(NOT launcher MATCHES "%~dp0runtime" OR NOT launcher MATCHES "Smoothmail.exe")
    message(FATAL_ERROR "Launcher must use its own directory to locate the executable.")
endif()
message(STATUS "Independent ZIP extraction and SHA256 inventory verification passed.")
