cmake_minimum_required(VERSION 3.30)
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
foreach(case IN ITEMS changed missing extra assignment duplicate traversal)
    if(case STREQUAL changed)
        set(expected "Runtime bytes changed")
    elseif(case STREQUAL missing)
        set(expected "Missing or linked evidence")
    elseif(case STREQUAL extra)
        set(expected "Runtime has missing or unclassified")
    elseif(case STREQUAL assignment)
        set(expected "Runtime inventory and license component")
    else()
        set(expected "Unsafe or duplicate runtime")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${case}"
        "-DROOT=${repository}/build/license-final-review-guards/${nonce}/${case}"
        -P "${CMAKE_CURRENT_LIST_DIR}/license_final_review_fixture.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(result STREQUAL "0" OR NOT "${err}" MATCHES "${expected}")
        message(FATAL_ERROR "Final license runtime guard failed: ${case}: ${out}\n${err}")
    endif()
endforeach()
message(STATUS "6 final license runtime hash/inventory/assignment guards passed.")
