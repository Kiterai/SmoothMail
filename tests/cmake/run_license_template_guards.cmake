cmake_minimum_required(VERSION 3.30)
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${repository}/build/license-template-guards/${nonce}")
set(cases valid final-status blank-lines missing empty duplicate unknown malformed http credentials expansion semicolon markdown multiline unknown-template unset-template)
foreach(case IN LISTS cases)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${case}" "-DROOT=${root}/${case}"
        -P "${CMAKE_CURRENT_LIST_DIR}/license_template_fixture.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if((case STREQUAL valid OR case STREQUAL final-status OR case STREQUAL blank-lines) AND NOT result STREQUAL "0")
        message(FATAL_ERROR "License template rendering failed: ${out}\n${err}")
    elseif(NOT case STREQUAL valid AND NOT case STREQUAL final-status AND NOT case STREQUAL blank-lines AND result STREQUAL "0")
        message(FATAL_ERROR "Unsafe license configuration accepted: ${case}")
    endif()
    if("${out}\n${err}" MATCHES "not-to-be-printed|user:secret")
        message(FATAL_ERROR "License environment values leaked into diagnostics.")
    endif()
endforeach()
list(LENGTH cases count)
message(STATUS "${count} license environment/template guards passed without shell evaluation.")
