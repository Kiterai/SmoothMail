cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/SourceArchives.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/PreparePatchedSource.cmake")
if(CASE STREQUAL unknown)
    smoothmail_archive_pin(unknown 1111111111111111111111111111111111111111 unused unused_tree)
endif()
set(commit 1111111111111111111111111111111111111111)
set(SMOOTHMAIL_SOURCE_ARCHIVES "${ROOT}/archives")
set(DEPENDENCY_ROOT "${ROOT}/deps")
file(MAKE_DIRECTORY "${ROOT}/original/fixture" "${SMOOTHMAIL_SOURCE_ARCHIVES}")
file(WRITE "${ROOT}/original/fixture/input.txt" "before\n")
file(WRITE "${ROOT}/original/fixture/.hidden" "hidden\n")
smoothmail_source_tree_digest("${ROOT}/original/fixture" fixture_tree)
set(archive "${SMOOTHMAIL_SOURCE_ARCHIVES}/fixture-${commit}.tar")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archive}" --format=gnutar fixture
    WORKING_DIRECTORY "${ROOT}/original" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${archive}" fixture_archive)
# Synthetic pin oracle only; no production option can override reviewed pins.
function(smoothmail_archive_pin dependency revision archive_hash tree_hash)
    if(NOT dependency STREQUAL fixture OR NOT revision STREQUAL "1111111111111111111111111111111111111111")
        message(FATAL_ERROR "Fixture revision mismatch.")
    endif()
    set(${archive_hash} "${fixture_archive}" PARENT_SCOPE)
    set(${tree_hash} "${fixture_tree}" PARENT_SCOPE)
endfunction()
if(CASE STREQUAL bad-archive)
    file(APPEND "${archive}" "changed")
elseif(CASE STREQUAL missing-archive)
    file(REMOVE "${archive}")
elseif(CASE STREQUAL revision)
    set(commit 2222222222222222222222222222222222222222)
endif()
smoothmail_import_source_archive(fixture "${commit}" source)
if(CASE STREQUAL changed-tree)
    file(WRITE "${source}/input.txt" "tampered\n")
elseif(CASE STREQUAL extra-file)
    file(WRITE "${source}/extra.txt" "extra\n")
elseif(CASE STREQUAL removed-file)
    file(REMOVE "${source}/.hidden")
elseif(CASE STREQUAL git-metadata)
    file(MAKE_DIRECTORY "${source}/.git")
    file(WRITE "${source}/.git/HEAD" "not a source file")
endif()
smoothmail_import_source_archive(fixture "${commit}" reused)
if(NOT source STREQUAL reused)
    message(FATAL_ERROR "Immutable source cache was not reused.")
endif()
set(patch "${ROOT}/change.patch")
file(WRITE "${patch}" "diff --git a/input.txt b/input.txt\n--- a/input.txt\n+++ b/input.txt\n@@ -1 +1 @@\n-before\n+after\n")
if(CASE STREQUAL bad-patch)
    file(WRITE "${patch}" "not a patch\n")
endif()
smoothmail_prepare_patched_source(fixture "${source}" "${commit}" "${patch}" "${ROOT}/patched" patched)
file(READ "${patched}/input.txt" actual)
if(NOT actual STREQUAL "after\n" OR NOT EXISTS "${source}/.hidden" OR EXISTS "${patched}/.git")
    message(FATAL_ERROR "Wrong patched source or fabricated Git repository.")
endif()
if(CASE STREQUAL changed-patched)
    file(WRITE "${patched}/input.txt" "tampered\n")
elseif(CASE STREQUAL extra-patched)
    file(WRITE "${patched}/extra.txt" "extra\n")
endif()
smoothmail_prepare_patched_source(fixture "${source}" "${commit}" "${patch}" "${ROOT}/patched" patched_again)
smoothmail_validate_archive_source(fixture "${source}" "${commit}")
