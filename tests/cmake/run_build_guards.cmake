cmake_minimum_required(VERSION 3.30)
find_package(Git REQUIRED)
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${repository}/build/build-guard-tests/${nonce}")
file(MAKE_DIRECTORY "${root}")
function(run expected)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(expected STREQUAL "pass" AND NOT result STREQUAL "0")
        message(FATAL_ERROR "Expected success: ${out}\n${err}")
    elseif(expected STREQUAL "fail" AND result STREQUAL "0")
        message(FATAL_ERROR "Guard unexpectedly accepted fixture.")
    endif()
endfunction()
function(git output)
    execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE text ERROR_VARIABLE err OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Fixture Git command failed: ${err}")
    endif()
    set(${output} "${text}" PARENT_SCOPE)
endfunction()

# Independent source fixtures for each potentially destructive failure case.
foreach(case IN ITEMS repeat generic tracked added staged receipt)
    set(work "${root}/patch-${case}")
    set(pristine "${work}/pristine")
    file(MAKE_DIRECTORY "${pristine}")
    git(unused init "${pristine}")
    git(unused -C "${pristine}" config core.autocrlf false)
    file(WRITE "${pristine}/config.txt" "before\n")
    git(unused -C "${pristine}" add config.txt)
    git(tree -C "${pristine}" write-tree)
    git(commit -C "${pristine}" -c "user.name=SmoothMail test" -c "user.email=test@example.invalid"
        commit-tree "${tree}" -m Fixture)
    git(unused -C "${pristine}" update-ref HEAD "${commit}")
    set(patch "${work}/change.patch")
    file(WRITE "${patch}" "diff --git a/config.txt b/config.txt\n--- a/config.txt\n+++ b/config.txt\n@@ -1 +1 @@\n-before\n+after\n")
    file(SHA256 "${patch}" hash)
    string(SUBSTRING "${hash}" 0 16 key)
    set(copy "${work}/copies/kio-${commit}-${key}")
    set(command "${CMAKE_COMMAND}" "-DPRISTINE=${pristine}" "-DCOMMIT=${commit}"
        "-DPATCH=${patch}" "-DWORKSPACE=${work}/copies")
    set(fixture "${CMAKE_CURRENT_LIST_DIR}/prepare_kio_fixture.cmake")
    run(pass ${command} -P "${fixture}")
    if(case STREQUAL repeat)
        run(pass ${command} -P "${fixture}")
    elseif(case STREQUAL generic)
        run(pass ${command} -DDEPENDENCY=kimap -P "${fixture}")
        run(pass ${command} -DDEPENDENCY=kimap -P "${fixture}")
        file(READ "${work}/copies/kimap-${commit}-${key}/config.txt" contents)
        if(NOT contents STREQUAL "after\n")
            message(FATAL_ERROR "Generic patched copy missing.")
        endif()
    elseif(case STREQUAL tracked)
        file(WRITE "${copy}/config.txt" "user change\n")
        run(fail ${command} -P "${fixture}")
        file(READ "${copy}/config.txt" contents)
        if(NOT contents STREQUAL "user change\n")
            message(FATAL_ERROR "User changes were overwritten.")
        endif()
    elseif(case STREQUAL added)
        file(WRITE "${copy}/extra.cpp" "// user source\n")
        run(fail ${command} -P "${fixture}")
        if(NOT EXISTS "${copy}/extra.cpp")
            message(FATAL_ERROR "User file was removed.")
        endif()
    elseif(case STREQUAL staged)
        git(unused -C "${copy}" add config.txt)
        run(fail ${command} -P "${fixture}")
    else()
        file(WRITE "${copy}.receipt.cmake" "file(WRITE \"${work}/executed\" \"bad\")\n")
        run(fail ${command} -P "${fixture}")
        if(EXISTS "${work}/executed")
            message(FATAL_ERROR "Receipt was executed.")
        endif()
    endif()
    file(READ "${pristine}/config.txt" contents)
    if(NOT contents STREQUAL "before\n")
        message(FATAL_ERROR "Pristine source was modified.")
    endif()
endforeach()

foreach(case IN ITEMS matching artifact qt patch configuration commit executable)
    set(work "${root}/receipt-${case}")
    file(MAKE_DIRECTORY "${work}")
    foreach(name IN ITEMS artifact qt patch)
        file(WRITE "${work}/${name}" "${name}")
        file(SHA256 "${work}/${name}" ${name}_hash)
    endforeach()
    set(commit fixture-commit)
    set(configuration Debug)
    if(case STREQUAL "configuration")
        set(configuration unexpected)
    elseif(case STREQUAL "commit")
        set(commit unexpected)
    endif()
    file(WRITE "${work}/receipt.json"
        "{\"commit\":\"${commit}\",\"configuration\":\"${configuration}\",\"artifact_sha256\":\"${artifact_hash}\",\"qtcore_sha256\":\"${qt_hash}\",\"patch_sha256\":\"${patch_hash}\"}")
    if(case MATCHES "^(artifact|qt|patch)$")
        file(WRITE "${work}/${case}" "replaced")
    elseif(case STREQUAL executable)
        file(WRITE "${work}/receipt.json" "file(WRITE \"${work}/executed\" \"bad\")")
    endif()
    if(case STREQUAL matching)
        set(expected pass)
    else()
        set(expected fail)
    endif()
    run(${expected} "${CMAKE_COMMAND}" "-DRECEIPT=${work}/receipt.json"
        "-DARTIFACT=${work}/artifact" "-DQTCORE=${work}/qt" "-DPATCH=${work}/patch"
        -P "${CMAKE_CURRENT_LIST_DIR}/modified_receipt_fixture.cmake")
    if(EXISTS "${work}/executed")
        message(FATAL_ERROR "Receipt was executed.")
    endif()
endforeach()

foreach(case IN ITEMS runtime-release existing missing release-debug release-existing)
    set(work "${root}/stage-${case}")
    file(MAKE_DIRECTORY "${work}")
    set(destination "${work}/destination")
    set(configuration Debug)
    set(script StageWindowsRuntime)
    set(app "${work}")
    if(case STREQUAL runtime-release)
        set(configuration Release)
    elseif(case MATCHES "existing")
        set(destination "${work}")
        file(WRITE "${work}/user-work.txt" "keep")
    elseif(case STREQUAL missing)
        set(app "${work}/missing.exe")
    endif()
    if(case MATCHES "^release-")
        set(script StageWindowsRelease)
        if(case STREQUAL release-existing)
            set(configuration Release)
        endif()
    endif()
    run(fail "${CMAKE_COMMAND}" "-DAPP=${app}" "-DQT_BIN=${work}" "-DDEPENDENCY_BIN=${work}"
        "-DNATIVE_BIN=${work}" "-DSASL_DIR=${work}" "-DCRT_BIN=${work}"
        "-DDESTINATION=${destination}" "-DCONFIGURATION=${configuration}"
        -P "${repository}/cmake/${script}.cmake")
    if(case MATCHES "existing")
        file(READ "${work}/user-work.txt" contents)
        if(NOT contents STREQUAL keep)
            message(FATAL_ERROR "Staging changed user work.")
        endif()
    elseif(EXISTS "${destination}")
        message(FATAL_ERROR "Invalid staging created a destination.")
    endif()
endforeach()
foreach(case IN ITEMS new matching changed unknown)
    if(case MATCHES "^(new|matching)$")
        set(expected pass)
    else()
        set(expected fail)
    endif()
    run(${expected} "${CMAKE_COMMAND}" "-DCASE=${case}" "-DROOT=${root}/native-profile-${case}"
        -P "${CMAKE_CURRENT_LIST_DIR}/native_profile_fixture.cmake")
endforeach()
file(READ "${root}/native-profile-unknown/user-work.txt" contents)
string(REPEAT "b" 64 old_profile)
file(READ "${root}/native-profile-changed/smoothmail-profile.sha256" installed)
if(NOT contents STREQUAL "keep" OR NOT installed STREQUAL "${old_profile}\n")
    message(FATAL_ERROR "Native profile guard overwrote existing inputs.")
endif()
message(STATUS "4 native profile guards passed.")
if(WIN32)
    foreach(mode IN ITEMS matching missing replaced missing-crash old-kio)
        if(mode STREQUAL matching)
            set(expected pass)
        else()
            set(expected fail)
        endif()
        run(${expected} "${CMAKE_COMMAND}"
            -S "${CMAKE_CURRENT_LIST_DIR}/kconfig_receipt_fixture"
            -B "${root}/kconfig-receipt-${mode}" "-DMODE=${mode}")
    endforeach()
    message(STATUS "5 modified KDE integration receipt guards passed.")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/run_download_guards.cmake")
if(WIN32)
    foreach(case IN ITEMS missing existing-directory existing-file missing-qt)
        set(clean_root "${root}/clean-${case}")
        set(arguments)
        if(case STREQUAL existing-directory)
            file(MAKE_DIRECTORY "${clean_root}")
            file(WRITE "${clean_root}/keep.txt" "keep")
        elseif(case STREQUAL existing-file)
            file(WRITE "${clean_root}" "keep")
        endif()
        if(NOT case STREQUAL missing)
            list(APPEND arguments "-DDEPENDENCY_ROOT=${clean_root}")
        endif()
        run(fail "${CMAKE_COMMAND}" ${arguments}
            -P "${repository}/cmake/VerifyWindowsCleanDependencies.cmake")
        if(case STREQUAL existing-directory)
            file(READ "${clean_root}/keep.txt" kept)
        elseif(case STREQUAL existing-file)
            file(READ "${clean_root}" kept)
        elseif(EXISTS "${clean_root}")
            message(FATAL_ERROR "Invalid clean verification created a dependency root.")
        endif()
        if(case MATCHES "^existing-" AND NOT kept STREQUAL keep)
            message(FATAL_ERROR "Clean verification overwrote existing content.")
        endif()
    endforeach()
    message(STATUS "4 clean dependency input guards passed (offline).")
endif()
message(STATUS "18 patch/receipt/staging cases and 4 download guards passed (offline).")
