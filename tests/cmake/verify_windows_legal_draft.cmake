cmake_minimum_required(VERSION 3.30)
foreach(required IN ITEMS DRAFT EVIDENCE HELPER)
    if(NOT EXISTS "${${required}}")
        message(FATAL_ERROR "Specify ${required}.")
    endif()
    get_filename_component(${required} "${${required}}" ABSOLUTE)
endforeach()
file(READ "${DRAFT}/manifest.review.json" draft)
file(READ "${EVIDENCE}/manifest.review.json" evidence)
string(JSON review_only GET "${draft}" review_only)
string(JSON count LENGTH "${draft}" components)
if(NOT review_only OR NOT count EQUAL 19 OR EXISTS "${DRAFT}/manifest.json")
    message(FATAL_ERROR "Legal draft was approved or component profile changed.")
endif()
set(binaries)
set(registered)
foreach(i RANGE 0 18)
    foreach(field IN ITEMS name binaries version)
        string(JSON actual GET "${draft}" components ${i} ${field})
        string(JSON expected GET "${evidence}" components ${i} ${field})
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Draft changed the collected runtime profile.")
        endif()
    endforeach()
    string(JSON n LENGTH "${draft}" components ${i} binaries)
    math(EXPR end "${n}-1")
    foreach(j RANGE 0 ${end})
        string(JSON binary GET "${draft}" components ${i} binaries ${j})
        if(binary IN_LIST binaries)
            message(FATAL_ERROR "Duplicate runtime assignment.")
        endif()
        list(APPEND binaries "${binary}")
    endforeach()
    string(JSON n LENGTH "${draft}" components ${i} license_files)
    if(n LESS 1)
        message(FATAL_ERROR "Empty license references.")
    endif()
    math(EXPR end "${n}-1")
    foreach(j RANGE 0 ${end})
        string(JSON license GET "${draft}" components ${i} license_files ${j})
        if(NOT EXISTS "${DRAFT}/${license}")
            message(FATAL_ERROR "Broken license reference.")
        endif()
        list(APPEND registered "${license}")
    endforeach()
    string(JSON notice GET "${draft}" components ${i} source_notice)
    list(APPEND registered "${notice}")
endforeach()
list(LENGTH binaries files)
if(NOT files EQUAL 34)
    message(FATAL_ERROR "Runtime count changed.")
endif()
file(GLOB_RECURSE originals LIST_DIRECTORIES FALSE RELATIVE "${EVIDENCE}" "${EVIDENCE}/licenses/*")
foreach(original IN LISTS originals)
    file(SHA256 "${EVIDENCE}/${original}" expected)
    file(SHA256 "${DRAFT}/${original}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "A collected original was changed or omitted.")
    endif()
endforeach()
# Every relative Markdown link must resolve inside the draft, including the
# generated component -> license links. External URLs are not fetched.
file(GLOB texts "${DRAFT}/*.md" "${DRAFT}/notices/*.md")
foreach(text IN LISTS texts)
    file(READ "${text}" body)
    if(NOT body MATCHES "^#[^\n]+\n")
        message(FATAL_ERROR "Missing notice title.")
    endif()
    if(text MATCHES "\\.ja\\.md$")
        string(REGEX REPLACE "\\.ja\\.md$" ".md" counterpart "${text}")
        if(NOT body MATCHES "英語正本" OR body MATCHES "です[。[:space:]]|ます[。[:space:]]|ください")
            message(FATAL_ERROR "Japanese notices must be plain-form translations of the English originals.")
        endif()
    else()
        string(REGEX REPLACE "\\.md$" ".ja.md" counterpart "${text}")
        if(NOT body MATCHES "English authoritative version|English documents are the authoritative")
            message(FATAL_ERROR "English notice lacks its authoritative-language designation.")
        endif()
    endif()
    if(NOT EXISTS "${counterpart}")
        message(FATAL_ERROR "Missing English/Japanese notice pair.")
    endif()
    file(RELATIVE_PATH notice_relative "${DRAFT}" "${text}")
    if(NOT notice_relative IN_LIST registered)
        message(FATAL_ERROR "Authored notice omitted from packaging/resource manifest: ${notice_relative}")
    endif()
    string(REGEX MATCHALL "\\]\\([^)\r\n]+\\)" links "${body}")
    # Unbalanced ']' prevents CMake from splitting a list at semicolons.
    string(REPLACE "](" "(" links "${links}")
    get_filename_component(parent "${text}" DIRECTORY)
    foreach(link IN LISTS links)
        string(REGEX REPLACE "^\\((.*)\\)$" "\\1" target "${link}")
        if(target MATCHES "^(https?://|#)")
            continue()
        endif()
        string(REGEX REPLACE "#.*$" "" target "${target}")
        file(REAL_PATH "${parent}/${target}" resolved)
        cmake_path(IS_PREFIX DRAFT "${resolved}" NORMALIZE inside)
        if(NOT inside OR NOT EXISTS "${resolved}")
            message(FATAL_ERROR "Broken or escaping draft Markdown link in ${text}.")
        endif()
    endforeach()
endforeach()
execute_process(COMMAND "${HELPER}" --check-legal "${DRAFT}"
    RESULT_VARIABLE rejected OUTPUT_QUIET ERROR_QUIET)
if(NOT rejected STREQUAL "1")
    message(FATAL_ERROR "Expected the helper's explicit rejection of unapproved input.")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(fixture "${DRAFT}/../legal-draft-rename-${nonce}")
file(MAKE_DIRECTORY "${fixture}")
file(COPY "${DRAFT}/" DESTINATION "${fixture}")
file(COPY_FILE "${DRAFT}/manifest.review.json" "${fixture}/manifest.json")
execute_process(COMMAND "${HELPER}" --check-legal "${fixture}"
    RESULT_VARIABLE renamed OUTPUT_QUIET ERROR_QUIET)
file(REMOVE_RECURSE "${fixture}")
if(NOT renamed STREQUAL "1")
    message(FATAL_ERROR "Expected the helper's explicit rejection of renamed input.")
endif()
list(LENGTH originals original_count)
list(LENGTH texts notice_count)
message(STATUS "Legal draft: 34 files / 19 components, ${original_count} unchanged originals, ${notice_count} paired/registered notices, links, unapproved/renamed input rejection passed.")
