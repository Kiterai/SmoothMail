cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/QtSourceSettings.cmake")
set(sdk "${ROOT}/ExistingSDK")
file(MAKE_DIRECTORY "${sdk}/lib")
file(WRITE "${sdk}/sentinel" "preserved")
set(output "${ROOT}/independent")
if(CASE STREQUAL same)
    set(output "${sdk}")
elseif(CASE STREQUAL child)
    set(output "${sdk}/new-build")
elseif(CASE STREQUAL parent)
    set(output "${ROOT}")
elseif(CASE STREQUAL case-child)
    string(TOLOWER "${sdk}/new-build" output)
elseif(CASE STREQUAL normalized)
    set(output "${ROOT}/other/../ExistingSDK/new-build")
endif()
smoothmail_check_qt_review_output("${sdk}" "${output}")
