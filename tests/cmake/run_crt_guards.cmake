cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/WindowsCrt.cmake")
smoothmail_parse_imports("Dump of file app.exe\n\n    Image has the following dependencies:\n\n    KERNEL32.dll\n    MSVCP140.dll\n    VCRUNTIME140.dll\n    VCRUNTIME140_1.dll\n\n    Image has the following delay load dependencies:\n\n    MSVCP140_2.dll\n\n  Summary\n" actual)
if(NOT actual STREQUAL "kernel32.dll;msvcp140.dll;vcruntime140.dll;vcruntime140_1.dll;msvcp140_2.dll")
    message(FATAL_ERROR "Ordinary/adjacent/delay-load import parser failed.")
endif()
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${repository}/build/crt-guard-tests/${nonce}")
foreach(case IN ITEMS required missing debug unsupported wrong-directory)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${case}" "-DROOT=${root}/${case}"
        -P "${CMAKE_CURRENT_LIST_DIR}/crt_graph_fixture.cmake"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(case STREQUAL required AND NOT result STREQUAL "0")
        message(FATAL_ERROR "Required CRT closure failed.")
    elseif(NOT case STREQUAL required AND result STREQUAL "0")
        message(FATAL_ERROR "Unsafe CRT graph was accepted.")
    endif()
endforeach()
message(STATUS "CRT import parser and five transitive selection/rejection guards passed (offline).")
