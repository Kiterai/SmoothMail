cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/DownloadAsset.cmake")
set(root "${CMAKE_CURRENT_LIST_DIR}/../../build/download-guard-tests")
file(MAKE_DIRECTORY "${root}")
file(WRITE "${root}/asset" "verified fixture")
file(SHA512 "${root}/asset" hash)
if(CASE STREQUAL "cache")
    smoothmail_download_asset("https://invalid.test/unused" SHA512 "${hash}" "${root}/asset")
elseif(CASE STREQUAL "hash")
    smoothmail_download_asset("https://invalid.test/unused" SHA512 bad "${root}/asset")
elseif(CASE STREQUAL "scheme")
    smoothmail_download_asset("http://invalid.test/unused" SHA512 "${hash}" "${root}/asset")
elseif(CASE STREQUAL "mismatch")
    string(REPEAT "0" 128 hash)
    smoothmail_download_asset("https://invalid.test/unused" SHA512 "${hash}" "${root}/asset")
else()
    message(FATAL_ERROR "Unknown test case")
endif()
