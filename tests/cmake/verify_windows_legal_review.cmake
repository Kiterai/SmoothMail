cmake_minimum_required(VERSION 3.30)
# Explicit real-evidence review test, not part of offline synthetic CTest.
foreach(required IN ITEMS REVIEW HELPER)
    if(NOT EXISTS "${${required}}")
        message(FATAL_ERROR "Specify ${required}.")
    endif()
endforeach()
if(EXISTS "${REVIEW}/manifest.json")
    message(FATAL_ERROR "Review evidence must not look like approved release input.")
endif()
file(READ "${REVIEW}/manifest.review.json" manifest)
string(JSON review_only GET "${manifest}" review_only)
if(NOT review_only)
    message(FATAL_ERROR "Missing review-only marker.")
endif()
string(JSON count LENGTH "${manifest}" components)
if(NOT count EQUAL 19)
    message(FATAL_ERROR "Unexpected component count.")
endif()
set(seen)
set(missing_licenses)
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
    string(JSON name GET "${manifest}" components ${index} name)
    string(JSON binaries LENGTH "${manifest}" components ${index} binaries)
    math(EXPR binary_last "${binaries}-1")
    foreach(i RANGE 0 ${binary_last})
        string(JSON binary GET "${manifest}" components ${index} binaries ${i})
        if(binary IN_LIST seen)
            message(FATAL_ERROR "Duplicate component assignment.")
        endif()
        list(APPEND seen "${binary}")
    endforeach()
    string(JSON notice GET "${manifest}" components ${index} source_notice)
    if(NOT EXISTS "${REVIEW}/${notice}")
        message(FATAL_ERROR "Missing source review notice.")
    endif()
    string(JSON licenses LENGTH "${manifest}" components ${index} license_files)
    if(licenses EQUAL 0)
        list(APPEND missing_licenses "${name}")
    else()
        math(EXPR license_last "${licenses}-1")
        foreach(i RANGE 0 ${license_last})
            string(JSON license GET "${manifest}" components ${index} license_files ${i})
            if(NOT EXISTS "${REVIEW}/${license}")
                message(FATAL_ERROR "Missing collected license evidence.")
            endif()
        endforeach()
    endif()
endforeach()
list(LENGTH seen files)
set(crt_count 0)
foreach(binary IN LISTS seen)
    if(binary MATCHES "^(msvcp|vcruntime|concrt|vccorlib).*\\.dll$")
        math(EXPR crt_count "${crt_count}+1")
    endif()
endforeach()
math(EXPR expected_files "29+${crt_count}")
if(crt_count LESS 1 OR NOT files EQUAL expected_files OR NOT "msvc-crt" IN_LIST missing_licenses)
    message(FATAL_ERROR "Inventory or known blockers changed; review the evidence.")
endif()
execute_process(COMMAND "${HELPER}" --check-legal "${REVIEW}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result STREQUAL "0")
    message(FATAL_ERROR "Unapproved review directory accepted as release legal input.")
endif()
# Merely renaming the draft cannot turn review evidence into release approval,
# even when all original license texts become available in a later review.
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(fixture "${repository}/build/legal-review-guards/${nonce}")
if(EXISTS "${fixture}")
    message(FATAL_ERROR "Fixture already exists.")
endif()
file(MAKE_DIRECTORY "${fixture}")
file(COPY "${REVIEW}/" DESTINATION "${fixture}")
file(COPY_FILE "${REVIEW}/manifest.review.json" "${fixture}/manifest.json")
execute_process(COMMAND "${HELPER}" --check-legal "${fixture}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result STREQUAL "0")
    message(FATAL_ERROR "Draft with missing Qt/CRT evidence accepted.")
endif()
# Remove only the exact random fixture created above.
file(REMOVE_RECURSE "${fixture}")
message(STATUS "${files} files / 19 components (${crt_count} CRT DLLs), evidence references and incomplete-release rejection verified.")
