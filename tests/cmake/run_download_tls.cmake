cmake_minimum_required(VERSION 3.30)
# Opt-in integration test; downloads only the manifest-pinned vcpkg executable.
# Runs each case in a child so expected FATAL_ERROR paths can be asserted.
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT SMOOTHMAIL_DOWNLOAD_CURL)
    message(FATAL_ERROR "Specify SMOOTHMAIL_DOWNLOAD_CURL for the TLS integration test.")
endif()
if(NOT CASE)
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
    set(root "${repository}/build/download-tls-${nonce}")
    foreach(case IN ITEMS cmake openssl hash ca)
        execute_process(COMMAND "${CMAKE_COMMAND}"
            "-DSMOOTHMAIL_DOWNLOAD_CURL=${SMOOTHMAIL_DOWNLOAD_CURL}"
            "-DCASE=${case}" "-DROOT=${root}" -P "${CMAKE_CURRENT_LIST_FILE}"
            RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(case STREQUAL "openssl")
            if(NOT result STREQUAL "0")
                message(FATAL_ERROR "OpenSSL verified download failed: ${err}")
            endif()
        elseif(case STREQUAL "cmake")
            # The test is specifically for the restricted-token failure.
            if(NOT err MATCHES "CMake status 35")
                message(FATAL_ERROR "Did not reproduce CMake TLS initialization failure.")
            endif()
        elseif(case STREQUAL "hash")
            if(NOT err MATCHES "Downloaded asset checksum mismatch")
                message(FATAL_ERROR "Hash mismatch was not rejected.")
            endif()
        elseif(case STREQUAL "ca")
            if(NOT err MATCHES "OpenSSL curl status 60")
                message(FATAL_ERROR "Untrusted certificate was not rejected: ${err}")
            endif()
        endif()
        if(NOT case STREQUAL "openssl" AND EXISTS "${root}/${case}.exe")
            message(FATAL_ERROR "Failed download was published.")
        endif()
        file(GLOB partials "${root}/*.part")
        if(partials)
            message(FATAL_ERROR "Failed download left partial files.")
        endif()
        message(STATUS "TLS integration ${case}: expected result confirmed")
    endforeach()
    message(STATUS "TLS evidence: ${root}")
    return()
endif()
include("${repository}/cmake/DownloadAsset.cmake")
file(READ "${repository}/cmake/native-dependencies.json" manifest)
string(JSON url GET "${manifest}" vcpkgTool url)
string(JSON hash GET "${manifest}" vcpkgTool sha512)
if(CASE STREQUAL "cmake")
    set(SMOOTHMAIL_DOWNLOAD_CURL "")
elseif(CASE STREQUAL "hash")
    string(REPEAT 0 128 hash)
elseif(CASE STREQUAL "ca")
    # Trust only our unrelated test certificate. No OS trust-store changes.
    set(ENV{CURL_CA_BUNDLE} "${repository}/tests/data/tls-cert.pem")
    file(MAKE_DIRECTORY "${ROOT}/curl-home")
    file(WRITE "${ROOT}/curl-home/.curlrc" "insecure\n")
    file(WRITE "${ROOT}/curl-home/_curlrc" "insecure\n")
    set(ENV{CURL_HOME} "${ROOT}/curl-home")
    # --disable must ignore this deliberately unsafe user configuration.
endif()
smoothmail_download_asset("${url}" SHA512 "${hash}" "${ROOT}/${CASE}.exe")
