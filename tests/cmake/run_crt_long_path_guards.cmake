cmake_minimum_required(VERSION 3.30)
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(DEFINED CASE)
    file(MAKE_DIRECTORY "${ROOT}/cmake" "${ROOT}/tools/windows-crt")
    file(COPY "${repository}/cmake/WindowsCrt.cmake" DESTINATION "${ROOT}/cmake")
    file(COPY "${repository}/tools/windows-crt/verify.cpp"
        "${repository}/tools/windows-crt/CMakeLists.txt" DESTINATION "${ROOT}/tools/windows-crt")
    include("${ROOT}/cmake/WindowsCrt.cmake")
    smoothmail_prepare_crt_verifier(helper)
    if(NOT EXISTS "${helper}" OR NOT helper MATCHES "/crt-v2-[0-9a-f]+/smoothmail_crt_verify.exe$")
        message(FATAL_ERROR "Missing short-path CRT verifier.")
    endif()
    get_filename_component(binary "${helper}" DIRECTORY)
    file(READ "${binary}/source-key.txt" key)
    string(LENGTH "${key}" key_length)
    if(NOT key_length EQUAL 64)
        message(FATAL_ERROR "Full verifier identity was not retained.")
    endif()
    if(CASE STREQUAL collision)
        file(WRITE "${binary}/source-key.txt" "different full source identity")
        smoothmail_prepare_crt_verifier(rejected)
        message(FATAL_ERROR "Collision was accepted.")
    endif()
    return()
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
foreach(case IN ITEMS valid collision)
    set(root "${repository}/build/crt-long-tests/${nonce}/${case}/exported")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${case}" "-DROOT=${root}"
        -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(case STREQUAL valid AND NOT result STREQUAL "0")
        message(FATAL_ERROR "CRT verifier failed in exported-source path: ${out}\n${err}")
    elseif(case STREQUAL collision AND (result STREQUAL "0" OR NOT err MATCHES "cache identity collision"))
        message(FATAL_ERROR "CRT verifier collision guard failed: ${out}\n${err}")
    endif()
endforeach()
message(STATUS "CRT verifier long-path build and full-identity collision guards passed.")
